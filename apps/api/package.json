{
  "name": "@steuereule/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run skills:generate && tsc -p tsconfig.json",
    "postinstall": "prisma generate && prisma generate --config prisma/keystore/prisma.config.ts && pnpm run skills:generate",
    "prisma:generate": "prisma generate && prisma generate --config prisma/keystore/prisma.config.ts",
    "migrate:deploy": "node scripts/migrate-deploy.mjs",
    "start": "pnpm run build && node --env-file-if-exists=.env dist/main.js",
    "test": "pnpm run skills:generate && vitest run --config vitest.config.ts",
    "test:integration": "pnpm run skills:generate && vitest run --config vitest.integration.config.ts",
    "test:live": "pnpm run skills:generate && vitest run --config vitest.live.config.ts",
    "test:eval": "pnpm run skills:generate && vitest run --config vitest.eval.config.ts",
    "typecheck": "pnpm run skills:generate && tsc --noEmit -p tsconfig.check.json",
    "openapi:spec": "tsx scripts/generate-openapi-spec.ts",
    "streets:fetch": "tsx scripts/fetch-street-data.ts",
    "skills:generate": "tsx scripts/generate-skills.ts",
    "backfill:identity": "tsx scripts/backfill-identity.ts",
    "rotate:field-key": "tsx scripts/rotate-field-encryption-key.ts",
    "laws:check": "tsx scripts/check-law-changes.ts",
    "seed:year-history": "tsx prisma/seed-year-history.ts",
    "seed:selbststaendig": "tsx prisma/seed-selbststaendig.ts"
  },
  "dependencies": {
    "@47ng/cloak": "1.2.0",
    "@better-auth/oauth-provider": "1.7.27",
    "@better-auth/passkey": "^1.7.27",
    "@better-auth/prisma-adapter": "1.7.27",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.1",
    "@langchain/anthropic": "^1.6.6",
    "@langchain/core": "^1.5.0",
    "@langchain/google-genai": "^2.3.7",
    "@langchain/langgraph": "^1.7.5",
    "@langchain/openai": "^1.8.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.8.0",
    "@opentelemetry/api": "^1.10.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/client-runtime-utils": "7.10.1",
    "@prisma/generator-helper": "7.10.1",
    "@steuereule/core": "workspace:*",
    "better-auth": "1.7.27",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.12.8",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.6.1",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "playwright-core": "1.65.1",
    "prisma": "7.10.1",
    "prisma-field-encryption": "^1.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "23.2.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fastify/proxy-addr": "^5.1.3",
    "@levischuck/tiny-cbor": "^0.3.6",
    "@nestjs/testing": "^11.1.28",
    "@swc/core": "^1.16.22",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.20.0",
    "light-my-request": "^6.8.1",
    "typescript": "^7.0.0",
    "unplugin-swc": "^1.5.9"
  }
}

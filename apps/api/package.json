{
  "name": "@steuereule/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postinstall": "prisma generate && prisma generate --schema prisma/keystore/schema.prisma",
    "prisma:generate": "prisma generate && prisma generate --schema prisma/keystore/schema.prisma",
    "migrate:deploy": "node scripts/migrate-deploy.mjs",
    "start": "pnpm run build && node dist/main.js",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:eval": "vitest run --config vitest.eval.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "openapi:spec": "tsx scripts/generate-openapi-spec.ts",
    "knowledge:generate": "tsx scripts/generate-advisor-knowledge.ts",
    "streets:fetch": "tsx scripts/fetch-street-data.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.15",
    "@better-auth/passkey": "^1.7.15",
    "@better-auth/prisma-adapter": "1.7.15",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^9.3.0",
    "@langchain/anthropic": "^1.6.1",
    "@langchain/core": "^1.3.5",
    "@langchain/google-genai": "^2.3.5",
    "@langchain/langgraph": "^1.7.2",
    "@langchain/openai": "^1.8.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.7.1",
    "@opentelemetry/api": "^1.10.0",
    "@prisma/client": "6.19.3",
    "@steuereule/core": "workspace:*",
    "better-auth": "1.7.15",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.10.0",
    "ioredis": "^5.11.1",
    "nodemailer": "^7.0.13",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.56.1",
    "prisma-field-encryption": "^1.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "23.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/proxy-addr": "^5.1.0",
    "@levischuck/tiny-cbor": "^0.2.11",
    "@nestjs/testing": "^11.1.28",
    "@swc/core": "^1.15.46",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^7.0.12",
    "light-my-request": "^6.6.0",
    "prisma": "6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^7.0.0",
    "unplugin-swc": "^1.5.9"
  }
}

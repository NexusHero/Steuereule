{
  "name": "@steuereule/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "start": "pnpm run build && node dist/main.js",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "openapi:spec": "tsx scripts/generate-openapi-spec.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.12",
    "@better-auth/prisma-adapter": "1.7.12",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.0",
    "@fastify/static": "^9.3.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "6.19.3",
    "@steuereule/core": "workspace:*",
    "better-auth": "1.7.12",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.10.0",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.56.1",
    "prisma-field-encryption": "^1.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "23.0.0"
  },
  "devDependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/proxy-addr": "^5.1.0",
    "@levischuck/tiny-cbor": "^0.2.11",
    "@nestjs/testing": "^11.1.28",
    "@swc/core": "^1.15.46",
    "@types/node": "^22.10.5",
    "light-my-request": "^6.6.0",
    "prisma": "6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^7.0.0",
    "unplugin-swc": "^1.5.9"
  }
}

// Prisma schema for the Onboarding Profile (steuereule#29).
// Managed EU Postgres, expand-only versioned migrations (ADR-047).
//
// !! The string `@encrypted` must NEVER appear in a FIELD's `///` doc comment except
// !! as the annotation itself (and likewise `@encryption:hash(...)` / `@encryption:cursor`).
// !! prisma-field-encryption's own regex is unanchored and reads a field's ENTIRE
// !! doc string — a comment that merely mentions `@encrypted` while explaining that a
// !! field is NOT encrypted silently becomes the annotation and encrypts the column
// !! (#325; verified in the installed prisma-field-encryption@1.6.0, dist/dmmf.js:78).
// !! Scoped to FIELD doc comments deliberately: analyseDMMF only ever reads
// !! `field.documentation` — a model's own `///` doc block (e.g. TaxYear's, below,
// !! which discusses `@encrypted` in prose) is never parsed, so the same string there
// !! is inert. If you need to explain an encryption decision in prose on a FIELD,
// !! write a plain `//` comment instead — Prisma's DMMF (and therefore this regex)
// !! never sees `//`; InterviewAnswer.questionId's comment below is the exemplar.
// !! `test/prisma-encrypted-fields.test.ts` asserts the actual encrypted/hashed field
// !! set (derived from `Prisma.dmmf`, not from this comment text) against a checked-in
// !! expected list — update that list in the same commit as any intentional change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One row per userId (guest session or real account, ADR-0007). Plain persisted
/// facts collected during Onboarding — no derived values, clean side of the
/// determinism boundary (ADR-014/048); @steuereule/core never recomputes these.
model Profile {
  id           String   @id @default(uuid())
  /// Scoping key. Never read from the request body/query/path — only ever set
  /// from the trusted userId the UserContextGuard produced (ADR-0007).
  userId       String   @unique
  /// The taxpayer's legal name. Field-encrypted at rest (ADR-0107 H3, pentest 2026-11-23):
  /// it used to sit in cleartext next to the encrypted steuerId, so a DB read / backup harvested
  /// every user's real name joinable to their (encrypted) Steuer-ID and income. Non-strict
  /// `@encrypted` (not `mode=strict` like steuerId): these are pre-existing columns that may still
  /// hold plaintext in non-prod, so reads decrypt-or-pass-through and every write re-encrypts —
  /// a zero-downtime switch. Tighten to `mode=strict` once a backfill has re-encrypted all rows.
  firstName    String /// @encrypted
  lastName     String /// @encrypted
  /// Steuerliche Identifikationsnummer — exactly 11 digits (validated server-side
  /// via @steuereule/core's isValidSteuerId before this is ever written). Nullable
  /// since ADR-0045 (value-first funnel): a user may save their name now and add the
  /// Steuer-ID later from Profil; null means "not given yet", never a blank string.
  /// Field-encrypted at rest (ADR-0008, prisma-field-encryption, AES-256-GCM,
  /// randomized nonce per write — ciphertext is longer than the plaintext digit
  /// string, so the column stays `String`, no type migration needed). `mode=strict`
  /// so a tampered/corrupted ciphertext throws on read instead of silently passing
  /// through as clear text or null (REQ-003.5) — safe once every existing row is
  /// encrypted, which is true from this migration onward.
  steuerId     String? /// @encrypted?mode=strict
  /// Optional — 1-13 digits if present (isValidSteuernummer). Field-encrypted at
  /// rest for the same reason as steuerId.
  steuernummer String? /// @encrypted?mode=strict
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// When a guest (an id without a User row, ADR-0007) last wrote anything. The guest-retention sweep
/// deletes all data of a guest id 30 days after this moment (ADR-0109). Written by UserContextGuard on a
/// guest's state-changing requests, at most once an hour per guest.
model GuestActivity {
  userId      String   @id
  lastWriteAt DateTime

  @@index([lastWriteAt])
}

/// Append-only audit trail of who touched a user's sensitive tax/profile fields, and
/// when (ADR-0008, REQ-004, DSGVO Art. 30 accountability). Deliberately carries no
/// value column — not the plaintext, not the ciphertext — only who/what/when. Never
/// updated or deleted at the application layer (no repository method exposes
/// anything but append); DB-level (role/trigger) enforcement is a follow-up.
model TaxDataAccessLog {
  id        String      @id @default(uuid())
  /// Scoping key — same trusted userId as Profile.userId (ADR-0007). Never joined
  /// across users; every read of this table is scoped to a single userId.
  userId    String
  action    AuditAction
  /// The resource/field-class touched, e.g. "profile". A short discriminator, never
  /// the sensitive value itself.
  resource  String
  /// Optional actor / client source: "assistent:<clientId>" for an MCP tool call of the user's assistant.
  source    String?
  createdAt DateTime    @default(now())

  @@index([userId])
  /// "Zuletzt aktiv" per connected assistant: the newest row of its source (beta P4, MCP-8).
  @@index([userId, source, createdAt])
  /// The retention sweep deletes rows older than RETENTION.auditLogYears (P7, H2-7).
  @@index([createdAt])
}

enum AuditAction {
  READ
  WRITE
}

// --- better-auth tables (ADR-0009/ADR-0012 §3) --------------------------------
// New tables only — a pure expand-only migration. None of these touch Profile or
// TaxDataAccessLog. Field/table shapes follow better-auth's own canonical Prisma
// schema (the shape its Prisma adapter queries against unconditionally) so no
// custom `modelName`/field-mapping config is needed on the betterAuth() side —
// Prisma's client property for each model is just its lowerCamelCase name
// (`prisma.user`, `prisma.session`, ...), which is exactly the model identifier
// the adapter looks up. better-auth's own `id` values are app-generated
// (typically a random id), but `@default(uuid())` is a safe DB-side fallback,
// mirroring Profile/TaxDataAccessLog's existing convention.

/// A real account (better-auth). `id` is the same userId namespace as a guest
/// session's opaque uuid (ADR-0012 §3) — Profile.userId holds either without a
/// type change, and REQ-006's guest->account upgrade just re-keys the FK value.
model User {
  id                 String              @id @default(uuid())
  name               String              /// @encrypted?mode=strict
  // ADR-0109: stored as ciphertext, found by `emailHash` (the extension rewrites `where: { email }`).
  // The unique index stays until the contract step: it holds for the plaintext rows of the migration window
  // and cannot clash on ciphertext, so it costs nothing and drops nothing.
  email              String              @unique /// @encrypted?mode=strict
  emailHash          String?             @unique /// @encryption:hash(email)?normalize=lowercase&normalize=trim
  emailVerified      Boolean             @default(false)
  image              String?
  /// Opt-in TOTP 2FA flag (REQ-007). Written only by better-auth's `two-factor`
  /// plugin (`enableTwoFactor`/`disableTwoFactor` set it, `verifyTOTP` flips it true
  /// after the one-code confirmation), never by this app's own controllers — the
  /// plugin owns the field exactly as it owns `twoFactor.secret`.
  twoFactorEnabled   Boolean             @default(false)
  /// ADR-0030 §3a: when the T-7 warning about the deletion of a never-verified account was sent.
  /// The account is deletable only 7 days after this, never on age alone. Unknown to better-auth.
  unverifiedWarningSentAt      DateTime? @map("unbestaetigtWarnungAm")
  /// ADR-0030 §2: when the T-1 reminder was sent.
  unverifiedFinalWarningSentAt DateTime? @map("unbestaetigtLetzteWarnungAm")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sessions           Session[]
  accounts           Account[]
  twoFactors         TwoFactor[]
  passkeys           Passkey[]
  oauthClients       OauthClient[]
  oauthConsents      OauthConsent[]
  oauthAccessTokens  OauthAccessToken[]
  oauthRefreshTokens OauthRefreshToken[]
}

/// DB-backed, server-revocable session (ADR-0012 §3). Read on every
/// authenticated request via UserContextGuard -> auth.api.getSession(); guest
/// requests never touch this table (ADR-0012 §2).
model Session {
  id                 String              @id @default(uuid())
  expiresAt          DateTime
  token              String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ipAddress          String?             /// @encrypted?mode=strict
  userAgent          String?             /// @encrypted?mode=strict
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthAccessTokens  OauthAccessToken[]
  oauthRefreshTokens OauthRefreshToken[]

  @@index([userId])
}

/// One row per credential/identity linked to a User — email+password today
/// (REQ-005), social providers later (REQ-008). Never logged in plaintext
/// (better-auth hashes with scrypt before this is ever written).
model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

/// Short-lived tokens: email verification, password reset (REQ-005/REQ-010).
model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

/// One row per user with opt-in TOTP 2FA (REQ-007). Owned end-to-end by better-auth's
/// `two-factor` plugin (its canonical shape from `schema.mjs`, unrenamed, so no
/// `schema.twoFactor.fields.*` override is needed): `secret`/`backupCodes` are written
/// by the plugin (the TOTP secret is encrypted at rest by better-auth via the instance
/// `secret`, never returned), `verified` is the "code confirmed?" gate the plugin flips
/// in `verifyTOTP`, and `failedVerificationCount`/`lockedUntil` back the plugin's own
/// sign-in brute-force lockout (`accountLockout` defaults `maxFailedAttempts` 10,
/// `durationSeconds` 900 — read from the installed 1.6.24 dist, not re-pinned here) —
/// deliberately NOT a hand-rolled limiter (ADR-0035: no bespoke machinery where the
/// framework answers). The plugin's own HTTP routes (`/api/auth/two-factor/*`) stay
/// enabled: they already carry session/`sensitiveSessionMiddleware` guards and a
/// per-route rate limit (the plugin's own `rateLimit` array, window 10s / max 3 — read
/// from the installed 1.6.24 dist, not separately tested), so there is nothing for a
/// Nest controller to interpose the way ADR-0024 did for the device plugin's
/// bearer-token route.
model TwoFactor {
  id                      String    @id @default(uuid())
  /// The TOTP secret — ciphertext (better-auth's `symmetricEncrypt`), `returned: false`.
  secret                  String
  /// Encrypted backup codes (`storeBackupCodes: "encrypted"` default).
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "Code confirmed" — better-auth's canonical schema defaults this to `true`
  /// (`@default(true)`); the plugin writes it explicitly: `false` on a fresh
  /// `enableTwoFactor`, `true` on `verifyTOTP` (the DB default only governs rows not
  /// created through the plugin). The user-visible "2FA on" flag is
  /// `User.twoFactorEnabled`, not this field.
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([userId])
  @@index([secret])
}

/// One row per registered WebAuthn passkey (REQ-007 passkey half, ticket 14). Owned
/// end-to-end by better-auth's `@better-auth/passkey` plugin (its canonical shape from
/// `src/schema.ts`, unrenamed, so no `schema.passkey.fields.*` override is needed):
/// `credentialID`/`publicKey`/`counter` are the WebAuthn credential the plugin verifies
/// against on sign-in (`verifyAuthenticationResponse` re-reads the stored public key and
/// bumps `counter` — the clone-detection signal), `deviceType`/`backedUp`/`aaguid`/
/// `transports` are the attestation metadata the plugin persists for display/management,
/// and `name` is the optional user label. `deviceType` is a plain `String`, not a Prisma
/// enum — the plugin writes the SimpleWebAuthn `CredentialDeviceType` union
/// (`"singleDevice" | "multiDevice"`) and a version bump adding a value must never fail a
/// CHECK constraint this schema didn't anticipate (same rule as DeviceCode.status).
///
/// Honest boundary (ticket 14, not silently dropped): the plugin implements passkeys as a
/// *passwordless sign-in method* (`POST /passkey/verify-authentication` mints a session),
/// NOT as a second factor inside better-auth's `two-factor` challenge flow — `twoFactorMethods`
/// only ever contains `totp`/`otp`. And `deletePasskey` is session- and ownership-gated but
/// does NOT require a password re-authentication the way TOTP's `disable` does (the plugin's
/// route uses `sessionMiddleware`, not `sensitiveSessionMiddleware`). Both are documented in
/// REQ-007's register row, not papered over with bespoke interposition (ADR-0035: no Eigenbau).
model Passkey {
  id           String   @id @default(uuid())
  /// Optional user-facing label; empty until the user names the credential.
  name         String?
  /// The credential's public key, base64-encoded (better-auth `base64.encode` of the
  /// COSE public key) — the verification half on sign-in.
  publicKey    String
  /// Scoping key — same trusted userId as every other model (ADR-0007). Never read from
  /// the request body/path.
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// WebAuthn credential ID (the raw ID bytes, base64url-encoded in responses) — the
  /// lookup key the plugin uses to find the stored credential on sign-in.
  credentialID String
  /// Signature counter from the last successful authentication — clone detection.
  counter      Int
  /// "singleDevice" | "multiDevice" (SimpleWebAuthn CredentialDeviceType) — plain string,
  /// see the model comment for why not an enum.
  deviceType   String
  /// Whether the credential is synced/backed up to the platform's cloud.
  backedUp     Boolean
  /// Comma-joined transport hints (e.g. "internal,hybrid") — display/allowCredentials only.
  transports   String?
  /// The authenticator model's AAGUID (attestation metadata); all-zero/absent for
  /// privacy-preserving platforms under `attestation: "none"`.
  aaguid       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([credentialID])
}

/// One row per (userId, steuerjahr) — the raw inputs behind the Cockpit's refund
/// estimate range (REQ-001, steuereule#91/#92). Deliberately stores only the plain
/// facts (`baseEstimate`/`openItems`/`openConflicts`); the derived range itself is
/// never persisted — it's recomputed on every read via @steuereule/core's
/// `cockpitRange()` (ADR-014/048 determinism boundary), so this table can never drift
/// out of sync with the uncertainty rule. No `/// @encrypted` field here: ruled
/// out-of-scope for ADR-0008 in review (Musti) — unlike Profile.steuerId this holds no
/// tax identifier, only a rounded refund estimate and two open-item/conflict counts.
/// Revisit if assessed amounts or income figures ever land on this entity.
model TaxYear {
  id               String   @id @default(uuid())
  /// Scoping key — same trusted userId as Profile.userId (ADR-0007). Never read from
  /// the request path/query/body.
  userId           String
  /// The tax year shown in the Cockpit (e.g. 2026). Part of the request path, but the
  /// row lookup is always userId-scoped first (`@@unique([userId, steuerjahr])`).
  taxYear          Int      @map("steuerjahr")
  /// Base estimate before the range is spread, in whole euro (>= 0). VESTIGIAL as of
  /// ticket 15 (Cockpit-Echtdaten): the Cockpit no longer reads this column — the spanne is
  /// now derived from @steuereule/core's `berechne`+`cockpitSpanne` over the real LStB/interview
  /// figures. Kept as a required column (no default) only so the existing write path
  /// (interview-answer.repository.prisma.ts) can keep seeding an honest `0`; a follow-up
  /// migration may drop it once every writer stops needing it.
  baseEstimate     Int
  /// Number of still-open interview/receipt items (>= 0).
  openItems        Int
  /// Number of open posten conflicts (ADR-008 "± offen"); defaults to 0 until that
  /// feature exists.
  openConflicts    Int      @default(0)
  /// The ADR-0039 state (core `TaxYearStatus`). `extern-erledigt` marks an Eckjahr: a year known
  /// only from an uploaded Bescheid, without an interview (ADR-0098 §4).
  status           String   @default("entwurf")
  /// „Schon abgegeben?“ for a year without data (ADR-0099 §1): ja | nein | weiss-nicht, null = not asked
  /// yet. „ja“ goes with status `extern-erledigt` (filed elsewhere, waiting for the Bescheid upload).
  filedElsewhere   String?  @map("abgabeAnderswo")
  /// The day of that answer (ISO); „weiss-nicht“ asks again three months before the deadline.
  filedElsewhereOn String?  @map("abgabeAnderswoAm")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, taxYear])
}

/// One row per (userId, steuerjahr, questionId) — the on-demand catalogue's stored answers
/// (#318 REQ-015's Minimal-Gate; #321's Segment 2 entry — #321 has no REQ id of its own yet,
/// that is Suhay's to create once its ticket is refined, ADR-0025; cite `#321` alone until then,
/// review F7). Additive: the Cockpit read path (REQ-001, Done) is untouched by this model. A gate
/// the user has seen and carried on past is stored here too, under its own gate id, with the
/// fixed value `GATE_ACKNOWLEDGED` (ADR-0033 §"Gates are answerable steps") — no separate model
/// for gates. One shared row set across every catalogue entry for the same (userId, steuerjahr) —
/// a catalogue entry is a named set of question ids over this same table, not a second model
/// (ADR-0031 §3); `packages/core/src/interview.ts`'s `entryForStep` derives which entry a given
/// row's `questionId` belongs to. Segment 2's rows are DECLARED here (this model admits any
/// `questionId` string) but nothing writes them yet — the only write path today is bound to
/// `ENTRIES['minimal-gate']`, so no Segment-2 row can exist in a real database until R2 (#321)
/// admits Segment-2 questionIds server-side. Do not read this model as though Segment-2 answers
/// are already live.
model InterviewAnswer {
  id         String   @id @default(uuid())
  /// Scoping key — same trusted userId as Profile.userId (ADR-0007). Never read from
  /// the request path/query/body.
  userId     String
  /// The tax year this answer belongs to — answers are collected per Steuerjahr, same
  /// granularity as TaxYear.
  taxYear    Int      @map("steuerjahr")
  /// An `EntryStepId` from packages/core/src/interview.ts's `QUESTIONS` registry — the current,
  /// exhaustive set (not hand-copied here, so this comment cannot drift the way ADR-0033
  /// already names as a real defect class for this file). Left in the clear (unlike `value`
  /// below) so uniqueness, lookup and remainingSteps()/isReachable()'s replay over stored
  /// answers keep working without decrypting anything.
  //
  // CAUTION (found the hard way, `//` not `///` deliberately — see below): prisma-field-
  // encryption matches a literal substring anywhere in a field's *own* `///` doc
  // comment (dmmf.js's encryptedAnnotationRegex — an "@" immediately followed by that
  // word, no negation-aware parsing). An earlier draft's doc comment for this field
  // *described* that other annotation in prose to explain why this field carries no
  // such annotation, and the description alone was enough to trip it — this plaintext
  // field silently got encrypted too. Never let that word (with its "@" prefix) appear
  // inside a `///` block for a field that must stay unencrypted; this note is `//` (a
  // plain comment, invisible to Prisma's DMMF and therefore to that regex) precisely
  // so explaining the trap can never re-trigger it.
  questionId String
  /// The stored answer value — one of that question's accepted values, or
  /// `GATE_ACKNOWLEDGED` for a gate row. Field-encrypted at rest from day one
  /// (ADR-0008 ruling in #318): unlike TaxYear this holds personal facts about the
  /// user (employment status, foreign work, children) that are joinable to Profile's
  /// Steuer-ID via the same userId. `mode=strict` — see Profile.steuerId's comment
  /// for why a tampered/corrupted ciphertext must throw on read, never pass through.
  value      String /// @encrypted?mode=strict
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, taxYear, questionId])
  @@index([userId, taxYear])
}

/// QR-code device-authorization (#238, RFC 8628, ADR-0024). better-auth's
/// `device-authorization` plugin owns this table's core nine fields — its own
/// canonical shape (`schema.mjs`), unrenamed, so no `schema.deviceCode.fields.*`
/// override is needed on the plugin config side. The plugin's own HTTP routes are
/// switched off via `disabledPaths` (ADR-0024) — only our `/v1/device/*` endpoints
/// and server-side `auth.api.*` calls ever touch this table, which is what makes the
/// four `request*` columns below safe to add: the plugin never reads or writes
/// them, so there is nothing for it to conflict with.
model DeviceCode {
  id              String    @id @default(uuid())
  /// RFC 8628 `device_code` — the polling secret, never shown to a human.
  deviceCode      String    @unique
  /// RFC 8628 `user_code` — the short code shown on the desktop and typed/matched on
  /// the phone. Looked up directly by the plugin's `/device`, `/device/approve`,
  /// `/device/deny` handlers.
  userCode        String    @unique
  /// Claimed by `/device` (GET) once a signed-in phone opens the verification URL —
  /// null while pending-unclaimed. Never the desktop's identity; always the
  /// approving phone's.
  userId          String?
  expiresAt       DateTime
  /// One of "pending" | "approved" | "denied" — a plain plugin-owned string, not a
  /// Prisma enum, so a plugin version bump introducing a new status value can never
  /// fail a CHECK constraint this schema didn't anticipate.
  status          String
  /// Set on each `/device/token` poll — backs the plugin's own `slow_down` throttle.
  lastPolledAt    DateTime?
  /// Milliseconds between polls (plugin's `interval` option, ms-encoded).
  pollingInterval Int?
  clientId        String?
  /// Space-separated OAuth-style scope string (plugin's own RFC 8628 field).
  scope           String?

  // --- Our columns (ADR-0024) — nullable, additive, never read by the plugin ---
  /// The desktop's User-Agent at `/v1/device/code` request time — match-verification
  /// evidence (AC-3) for the phone's approval screen, never the approving phone's own.
  requestUserAgent String?
  /// The desktop's request IP at `/v1/device/code` time — the geo-IP resolver's
  /// input (task 0b); never persisted alongside a resolved region that could outlive
  /// its own accuracy guarantee (the resolver re-derives `requestRegion` once, at
  /// write time, from this same value).
  requestIp        String?
  /// Country-level result of resolving `requestIp` (task 0b) — `null` until
  /// resolved, "unknown" (never a guess) when the address is private/unroutable or
  /// the geo-IP database is stale (ADR-0021 control). Two consumers: the phone's
  /// match-verification approval screen and the device list in Profil.
  requestRegion    String?
  /// When the desktop's `/v1/device/code` request was made — distinct from
  /// `expiresAt`/`lastPolledAt`, which are the plugin's own protocol timestamps.
  requestedAt      DateTime?

  @@index([userId])
}

/// Minimal Löschschutz seam (ADR-0013 §5, product ADR-011). While a hold is active
/// (`holdUntil` in the future) for a given userId/resource pair, the account-deletion
/// transaction exempts that resource from erasure/anonymisation instead of tearing it
/// down. `resource` names the thing held — today only "profile" and "auditLog" are
/// meaningful (no filing/tax-year Löschschutz model persists yet), so the exempt set
/// is vacuous in real use; the REQ-011 acceptance test seeds a synthetic row to
/// exercise both the exempt and non-exempt branches for real. Expand-only: this
/// migration adds only this one new table, no change to any existing model.
model LegalHold {
  id        String   @id @default(uuid())
  /// Scoping key — same trusted userId namespace as Profile/TaxDataAccessLog.
  userId    String
  /// The resource held, e.g. "profile" or "auditLog" — matches the model the
  /// deletion transaction consults it against, never a free-text label.
  resource  String
  /// The hold is active while `holdUntil` is in the future; once past, the deletion
  /// transaction treats it as expired and proceeds normally.
  holdUntil DateTime
  /// The one row held (P7): `Unlock.id` for resource "unlock", `FilingVersion.id` for "filingVersion".
  /// Null holds the whole resource category ("profile", "taxData", "auditLog"), as an operator sets it.
  resourceId String?
  /// Why the row is held, e.g. "§ 147 AO" — the legal basis the deletion answer names.
  reason     String?
  createdAt DateTime @default(now())

  @@unique([resource, resourceId])
  @@index([userId])
  @@index([holdUntil])
}

/// One row per uploaded receipt (ADR-007/008). Lands UNBOUND (no year): the user
/// photographs a receipt at the moment of receipt, not while filing. The extraction
/// SUGGESTS a Steuerjahr — payment date over invoice date (§ 11 EStG Zufluss/Abfluss:
/// the payment date fixes the year, not the invoice date) — and a tap confirms.
/// Assigning a year that contradicts the date-derived suggestion yields a visible
/// KONFLIKT state, never a silent overwrite (ADR-008). Scan/OCR is out of scope here
/// (ADR-036/045, later slices) — this model stores the DATA interface only: dates,
/// filename, confirmed year. The Zuordnung STATE is deliberately not a column: it is
/// derived on every read from (steuerjahr, belegdatum, zahlungsdatum) via
/// @steuereule/core's `zuordnungAusDaten` (ADR-014/048 determinism boundary — a stored
/// copy of a derivable state could only drift). `dateiname` is field-encrypted at rest
/// (ADR-0008): filenames can carry PII, and the column is joinable to Profile's
/// Steuer-ID via the same userId. The dates stay in the clear — the suggestion rule and
/// the (userId, steuerjahr) index need them without decrypting, and a date alone is not
/// a tax identifier (the ADR-0008 ruling that put InterviewAnswer.value in the clear was
/// about uniqueness/lookup; here it is about the derived-state rule, same instinct).
model Receipt {
  id                String       @id @default(uuid())
  /// Scoping key — same trusted userId as Profile.userId (ADR-0007). Never read from the
  /// request path/query/body.
  userId            String
  /// Original filename/storage key. Encrypted at rest (ADR-0008).
  fileName          String       @map("dateiname") /// @encrypted?mode=strict
  /// Document type (ADR-029): one of belegart.ts's `Belegart` values (Lohnausweis,
  /// Quellensteuer, Pensionskasse, Saeule3a, Krankenkasse, Familienzulage, Sonstiges) —
  /// null is the pre-CH undifferentiated receipt (not yet classified); 'Sonstiges' is an
  /// explicitly chosen generic receipt. A plain discriminator, not a tax fact: left in the
  /// clear (no field-level protection, same reasoning as the dates) so the inbox can group
  /// by it without decrypting.
  kind              String?      @map("art")
  /// Invoice date (Rechnungsdatum). Clear — the suggestion rule reads it without decrypting.
  belegdatum        DateTime?
  /// Payment date (Zahlungsdatum) — § 11 Zufluss fixes the year, not the invoice date.
  zahlungsdatum     DateTime?
  /// The CONFIRMED year (a tap has happened). Null while unbound/suggested. The
  /// suggestion itself is derived, never stored.
  taxYear           Int?         @map("steuerjahr")
  /// ADR-008 "bei meinem Jahr bleiben": whether the user explicitly dismissed the
  /// date-derived suggestion to keep their own confirmed year — a persisted FACT (not the
  /// derived state), so `zuordnungAusDaten` can resolve the conflict without silently
  /// overwriting the contradicting dates.
  proposalDismissed Boolean      @default(false) @map("vorschlagVerworfen")
  /// Whose document it is (ADR-0092): `A`, `B` or `kind:<child id>`, comma-separated — the first is the
  /// holder, the others the people a multi-person document was also taken over for („auch für …“).
  /// Null while nobody is chosen. A family relation, so encrypted like the names it points to.
  holders           String?      @map("inhaber") /// @encrypted?mode=strict
  /// The tax year the holders refer to (B and the children are per year). Clear, like `steuerjahr`.
  holderTaxYear     Int?         @map("inhaberSteuerjahr")
  /// ADR-0097: the facts of the last read, from which the processing state is derived (never stored).
  /// Clear like the dates: a timestamp, an outcome code and a reason code, no content of the document.
  /// When the document was read last; null while it never was.
  readAt            DateTime?    @map("gelesenAm")
  /// How that read ended: `werte` (drafts proposed), `nichts` (nothing for the return), `fehler` (not readable).
  readOutcome       String?      @map("leseErgebnis")
  /// Why it ended without values or failed: a code of core's `RECEIPT_READ_REASONS`.
  readReason        String?      @map("leseGrund")
  /// The tax year the read staged its drafts in (ADR-0097 §5: the document's own year).
  draftsTaxYear     Int?         @map("entwurfSteuerjahr")
  /// A business receipt (ADR-0101 §6): "ausgabe" (an expense) or "einnahme" (an invoice the business wrote).
  direction         String?      @map("richtung")
  /// The OAuth client id of the user's assistant that uploaded it through MCP (beta P4, H2-24): only that
  /// assistant may take it back. Null for everything the user uploaded. An id, not a name: clear.
  uploadedByClientId String?     @map("hochgeladenVonClient")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  file              ReceiptFile?

  @@index([userId])
  @@index([userId, taxYear])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("Beleg")
}

/// One row per (userId, steuerjahr) — the LStB (Lohnsteuerbescheinigung) guided-mask data for the
/// Angestellte-Vertikale (ticket 08, ADR-036 Scan-Fallback). The user transcribes the three printed
/// figures (Bruttoarbeitslohn, einbehaltene Lohnsteuer, SV-Arbeitnehmeranteil) field by field; the
/// photo stays stored as a Beleg (ADR-007), and Scan/OCR is a later slice (ADR-045). Each field's
/// stored string encodes its honest state (packages/core/src/lstb.ts is the ONE place that maps):
/// `null` = `offen` (not reached yet), the reserved marker `unklar` = "looked but could not read",
/// any other string = a whole-euro amount (`erfasst`). The derived `LstbZustand`
/// (unvollstaendig / widerspruch / vollstaendig) is recomputed on every read via @steuereule/core's
/// `lstbZustand`, never stored (ADR-014/048 determinism boundary). The figures are field-encrypted
/// at rest (ADR-0008): actual income is the most sensitive personal fact a tax app holds, joinable
/// to Profile's Steuer-ID via the same userId — unlike TaxYear (counts only) or the Beleg dates
/// (needed clear for the suggestion rule).
model Lstb {
  id                    String   @id @default(uuid())
  /// Scoping key — same trusted userId as Profile.userId (ADR-0007). Never read from the
  /// request path/query/body.
  userId                String
  /// The tax year these figures belong to (same granularity as TaxYear/InterviewAnswer).
  taxYear               Int      @map("steuerjahr")
  /// Bruttoarbeitslohn (Zeile 3). Encrypted at rest (ADR-0008); null=offen, "unklar"=unreadable.
  bruttoarbeitslohn     String? /// @encrypted?mode=strict
  /// Einbehaltene Lohnsteuer (Zeile 4). Encrypted at rest; same state encoding.
  lohnsteuer            String? /// @encrypted?mode=strict
  /// Arbeitnehmer-Anteil der SV-Beiträge (Zeilen 22/23). Encrypted at rest; same state encoding.
  sozialversicherung    String? /// @encrypted?mode=strict
  /// Einbehaltene Kirchensteuer des Arbeitnehmers (Zeile 6), whole euros; null = not entered (ADR-0063).
  kirchensteuer         String? /// @encrypted?mode=strict
  /// Kirchensteuer des Ehegatten, nur bei konfessionsverschiedener Ehe (Zeile 7); null = not entered.
  kirchensteuerEhegatte String? /// @encrypted?mode=strict
  /// Steuerfreie Arbeitgeberzuschüsse zur Kranken- und Pflegeversicherung (Zeile 24 a–c), whole euros; null = not entered (ADR-0090).
  zuschuesseKvPv        String? /// @encrypted?mode=strict
  /// The insurance block line by line (ADR-0093), whole euros; null = not entered. Zeile 23 a/b:
  /// employee pension contribution.
  rvArbeitnehmer        String? /// @encrypted?mode=strict
  /// Zeile 22 a/b: employer pension contribution.
  rvArbeitgeber         String? /// @encrypted?mode=strict
  /// Zeile 25: employee contribution to statutory health insurance.
  kvArbeitnehmer        String? /// @encrypted?mode=strict
  /// Zeile 26: employee contribution to care insurance.
  pvArbeitnehmer        String? /// @encrypted?mode=strict
  /// Zeile 27: employee contribution to unemployment insurance.
  avArbeitnehmer        String? /// @encrypted?mode=strict
  /// Zeile 24c: the care-insurance part of the tax-free employer subsidy.
  zuschussPv            String? /// @encrypted?mode=strict
  /// Zeile 5: withheld Solidaritätszuschlag, euros with cents as a decimal string ("165.44").
  solidaritaetszuschlag String? /// @encrypted?mode=strict
  /// The employer named on the certificate (ADR-0099 §8), for „neuer Arbeitgeber“ in the Verlauf.
  arbeitgeber           String? /// @encrypted?mode=strict
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([userId, taxYear])
}

/// One row per (userId, steuerjahr) — the CH-Lohnausweis guided-mask data (ADR-036 Scan-Fallback,
/// Grenzgänger-CH vertical, ticket 16). The user transcribes the 15 printed Ziffern (Formular 11,
/// ESTV) field by field in paper order; the photo stays stored as a Beleg (ADR-007), and Scan/OCR is
/// a later slice (ADR-045). Each CHF field's stored string encodes its honest state
/// (packages/core/src/grenzgaenger.ts is the ONE place that maps): `null` = `offen` (not reached
/// yet), the reserved marker `unklar` = "looked but could not read", any other string = a whole-CHF
/// amount (`erfasst`). `bemerkungen` (Ziffer 15) is Freitext and stores its text directly. The
/// figures are field-encrypted at rest (ADR-0008): actual income is the most sensitive personal
/// fact a tax app holds, joinable to Profile's Steuer-ID via the same userId. The Wechselkurs
/// (ADR-012) and the optional Säule 3a / Krankenkasse amounts (ADR-029 points 4–5) live on the same
/// row — the fold (grenzgaengerStand) reads them all, so a partial re-read resumes without losing
/// the Kurs the CHF→EUR conversion was made with. The Wechselkurs columns stay in the clear: the
/// BMF rate is public and the fold needs them without decrypting.
model ChSalaryCertificate {
  id                               String   @id @default(uuid())
  /// Scoping key — same trusted userId as Profile.userId (ADR-0007). Never read from the
  /// request path/query/body.
  userId                           String
  /// The tax year these figures belong to (same granularity as TaxYear/Lstb).
  taxYear                          Int      @map("steuerjahr")
  /// Ziffer 1 — Lohn (Grundlohn). Encrypted at rest; null=offen, "unklar"=unreadable.
  lohn                             String? /// @encrypted?mode=strict
  /// Ziffer 2 — Gehaltsnebenleistungen. Encrypted at rest.
  gehaltsnebenleistungen           String? /// @encrypted?mode=strict
  /// Ziffer 3 — Unregelmäßige Leistungen. Encrypted at rest.
  irregularBenefits                String?  @map("unregelmaessigeLeistungen") /// @encrypted?mode=strict
  /// Ziffer 4 — Kapitalleistungen. Encrypted at rest.
  kapitalleistungen                String? /// @encrypted?mode=strict
  /// Ziffer 5 — Beteiligungsrechte. Encrypted at rest.
  beteiligungsrechte               String? /// @encrypted?mode=strict
  /// Ziffer 6 — Sitzungsgelder. Encrypted at rest.
  sitzungsgelder                   String? /// @encrypted?mode=strict
  /// Ziffer 7 — Andere Leistungen. Encrypted at rest.
  otherBenefits                    String?  @map("andereLeistungen") /// @encrypted?mode=strict
  /// Ziffer 8 — Total Bruttolohn (postenRelevant: Einkünfte). Encrypted at rest.
  grossWageTotal                   String?  @map("bruttolohnTotal") /// @encrypted?mode=strict
  /// Ziffer 9 — AHV/IV/EO/ALV/NBUV (1. Säule). Encrypted at rest.
  ahvContributions                 String?  @map("ahvBeitraege") /// @encrypted?mode=strict
  /// Ziffer 10 — berufliche Vorsorge (2. Säule / PK, postenRelevant: Vorsorgeaufwand). Encrypted.
  occupationalPension              String?  @map("beruflicheVorsorge") /// @encrypted?mode=strict
  /// Ziffer 11 — Nettolohn. Encrypted at rest.
  nettolohn                        String? /// @encrypted?mode=strict
  /// Ziffer 12 — Quellensteuerabzug (postenRelevant: Anrechnung). Encrypted at rest.
  quellensteuer                    String? /// @encrypted?mode=strict
  /// Ziffer 13 — Spesen. Encrypted at rest.
  spesen                           String? /// @encrypted?mode=strict
  /// Ziffer 14 — Weitere Nebenleistungen. Encrypted at rest.
  otherFringeBenefits              String?  @map("weitereNebenleistungen") /// @encrypted?mode=strict
  /// Ziffer 15 — Bemerkungen (Freitext). Encrypted at rest (free text can carry PII).
  bemerkungen                      String? /// @encrypted?mode=strict
  /// Säule 3a (ADR-029 point 4) — optional whole-CHF amount, null = not entered. Encrypted.
  saeule3aChf                      String? /// @encrypted?mode=strict
  /// CH-Krankenkasse (ADR-029 point 5) — optional whole-CHF amount, null = not entered. Encrypted.
  krankenkasseChf                  String? /// @encrypted?mode=strict
  /// Supplementary health insurance (VVG), whole CHF: other provision, not basic cover (ADR-0093).
  krankenkasseZusatzChf            String? /// @encrypted?mode=strict
  /// Anlage Vorsorgeaufwand Zeile 49: entitled to tax-free subsidies to health insurance; null = not answered.
  kvZuschussAnspruch               Boolean?
  /// Whether the family allowance is contained in the gross wage of Ziffer 8; only then N-Gre Zeile 8
  /// deducts it (ADR-0093). null = recorded before the question existed.
  familienzulagenImBruttolohn      Boolean?
  /// Anlage N-Gre: employer (Zeilen 89–91), Familienzulagen (Z. 8/76), Krankentaggeld (Z. 80),
  /// Säule 2a Obligatorium employee/employer (Z. 84/87); whole CHF, null = not entered.
  arbeitgeberName                  String? /// @encrypted?mode=strict
  arbeitgeberStrasse               String? /// @encrypted?mode=strict
  arbeitgeberPlzOrt                String? /// @encrypted?mode=strict
  familienzulagenChf               String? /// @encrypted?mode=strict
  krankentaggeldChf                String? /// @encrypted?mode=strict
  pkArbeitnehmerChf                String? /// @encrypted?mode=strict
  pkArbeitgeberChf                 String? /// @encrypted?mode=strict
  /// All employer pension contributions (Obligatorium + Überobligatorium); the part above
  /// pkArbeitgeberChf is taxable wage on N-Gre Zeile 20 (ADR-0072). Whole CHF, null = not entered.
  pkArbeitgeberGesamtChf           String? /// @encrypted?mode=strict
  /// Tax-free Krankentaggeld paid out and contained in Ziffer 8 (N-Gre Zeilen 9/76). Whole CHF.
  steuerfreiesKrankentaggeldChf    String? /// @encrypted?mode=strict
  /// Daily benefit of the Swiss accident insurance (UVG/SUVA) paid out and contained in Ziffer 8 (N-Gre
  /// line „SUVA – Geld“). Tax-free, but under the progression clause (§ 32b EStG). Whole CHF.
  steuerfreiesUnfalltaggeldChf     String? /// @encrypted?mode=strict
  /// Where a daily benefit in Ziffer 8 came from (core DAILY_BENEFIT_SOURCES): the insurance (deducted, sickness
  /// field), the employer's continued pay (wage, nothing deducted), both (only the insurer's part deducted), the
  /// accident insurance (accident field), maternity / IV, or none (ADR-0072, Punkt 5). Health data: encrypted.
  taggeldQuelle                    String? /// @encrypted?mode=strict
  /// Who pays the Kollektivkrankentaggeld / NBUV premium (N-Gre Zeilen 18/19, 95–98): employer share in
  /// percent (0–100), plus the employer CHF only when it pays everything; null = not entered.
  krankentaggeldArbeitgeberProzent String? /// @encrypted?mode=strict
  krankentaggeldArbeitgeberChf     String? /// @encrypted?mode=strict
  nbuvArbeitgeberProzent           String? /// @encrypted?mode=strict
  nbuvArbeitgeberChf               String? /// @encrypted?mode=strict
  /// Any of N-Gre Zeilen 7, 10–14, 16, 17, 21, 22 applies — not printable yet.
  nGreSonderfaelle                 Boolean?
  /// Wechselkurs-Monat (yyyy-mm), or the year (yyyy) for the Jahresdurchschnittskurs (ADR-012, ADR-0072).
  exchangeRateMonth                String?  @map("wechselkursMonat")
  /// Wechselkurs-Kurs (EUR per 1 CHF, strictly positive) — public BMF rate, clear.
  exchangeRateValue                Float?   @map("wechselkursKurs")
  /// Wechselkurs-Modus (amtlich | jahresdurchschnitt | tatsaechlich). Clear.
  exchangeRateMode                 String?  @map("wechselkursModus")
  /// Beleg id for a tatsächlicher Kurs (ADR-012: "ohne Beleg kein tatsächlicher Kurs"). Clear.
  exchangeRateReceiptId            String?  @map("wechselkursBelegId")
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  @@unique([userId, taxYear])
  @@map("ChLohnausweis")
}

/// One row per (userId, steuerjahr) — the Rentner guided-mask data (product ADR-034, Anlage R,
/// ticket 10.4). The user transcribes their Rentenbezugsmitteilung: the Rentenart (product ADR-036
/// §3 — one of the five 1.0 kinds), the Jahresbetrag, and either the Rentenbeginn-Jahr
/// (Besteuerungsanteil path) or the Rentenbeginn-Lebensalter (Ertragsanteil path for the private
/// Rentenversicherung). Scan/OCR is a later slice (ADR-045). Each field's stored string encodes its
/// honest state (packages/core/src/rente.ts is the ONE place that maps): `null` = `offen` (not
/// reached yet), the reserved marker `unklar` = "looked but could not read", any other string = a
/// non-negative integer (`erfasst`). The taxable share (Jahresbetrag × Besteuerungs-/Ertragsanteil)
/// is recomputed on every read via @steuereule/core's `renteAlsKernposten`, never stored
/// (ADR-014/048 determinism boundary). `rentenart` is a plain discriminator (null = not yet chosen),
/// left in the clear like Beleg.art — the five values are not joinable PII and the screen needs them
/// to render the picker without decrypting. The three figures are field-encrypted at rest (ADR-0008):
/// actual income is the most sensitive personal fact a tax app holds, and the Rentenbeginn-Jahr /
/// -Lebensalter are personal facts that fix the tax treatment, joinable to Profile's Steuer-ID via
/// the same userId.
model Pension {
  id                   String   @id @default(uuid())
  /// Scoping key — same trusted userId as Profile.userId (ADR-0007). Never read from the
  /// request path/query/body.
  userId               String
  /// The tax year these figures belong to (same granularity as TaxYear/Lstb/ChLohnausweis).
  taxYear              Int      @map("steuerjahr")
  /// One of rente.ts's five `Rentenart` values, null = not yet chosen. Clear (plain discriminator).
  rentenart            String?
  /// Jahresbetrag der Rente (whole euros). Encrypted at rest; null=offen, "unklar"=unreadable.
  jahresbetrag         String? /// @encrypted?mode=strict
  /// Jahr des Rentenbeginns — fixes the Besteuerungsanteil (aa). Encrypted at rest; same encoding.
  rentenbeginnJahr     String? /// @encrypted?mode=strict
  /// Vollendetes Lebensjahr bei Rentenbeginn — fixes the Ertragsanteil (bb). Encrypted at rest.
  alterBeiRentenbeginn String? /// @encrypted?mode=strict
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId, taxYear])
  @@map("Rente")
}

/// One row per (userId, steuerjahr) — the Kapital guided-mask data (ticket 10.5, product
/// ADR-032, Anlage KAP). The user transcribes their Jahressteuerbescheinigung: the
/// Kapitalerträge (Einkünfte aus Kapitalvermögen, whole euros). The depot kind (Deutscher /
/// Ausländischer Broker / Krypto) is NOT a column — it is the persisted interview answer
/// `kap-depot`, read through the interview repository on every request (one source, no
/// denormalized copy that can drift). The stored string encodes its honest state
/// (packages/core/src/kapital.ts is the ONE place that maps): `null` = `offen` (not reached
/// yet), the reserved marker `unklar` = "looked but could not read", any other string = a
/// non-negative integer (`erfasst`). The derived Kapital-Posten and the § 32d Abs. 6
/// Günstigerprüfung are recomputed on every read via @steuereule/core (kapitalStand /
/// guenstigerpruefung), never stored (ADR-014/048 determinism boundary). The figure is
/// field-encrypted at rest (ADR-0008): actual capital income is among the most sensitive
/// personal facts a tax app holds, joinable to Profile's Steuer-ID via the same userId.
model Capital {
  id                    String   @id @default(uuid())
  /// Scoping key — same trusted userId as Profile.userId (ADR-0007). Never read from the
  /// request path/query/body.
  userId                String
  /// The tax year these figures belong to (same granularity as Lstb/ChLohnausweis/Rente).
  taxYear               Int      @map("steuerjahr")
  /// Kapitalerträge (Einkünfte aus Kapitalvermögen, whole euros). Encrypted at rest;
  /// null=offen, "unklar"=unreadable.
  kapitalertraege       String? /// @encrypted?mode=strict
  /// Anlage KAP Zeile 16/17 and the withheld taxes of Zeilen 37–39, same encoding.
  sparerPauschbetrag    String? /// @encrypted?mode=strict
  kapitalertragsteuer   String? /// @encrypted?mode=strict
  solidaritaetszuschlag String? /// @encrypted?mode=strict
  kirchensteuer         String? /// @encrypted?mode=strict
  /// Whose capital income (ADR-0054): A, B or gemeinsam (a joint account, split half and half). Clear —
  /// it carries no amount. null = A.
  inhaber               String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([userId, taxYear])
  @@index([userId])
  @@map("Kapital")
}

/// One row per (userId, steuerjahr, id) — ONE Vermietungsobjekt of the guided mask (ticket 10.6,
/// product ADR-033, Anlage V einfach). Several ganzjährig vermietete objects, each its own
/// Anlage V, each its own row here (the list nature of Vermietung is the reason this is a
/// separate model, not a JSON column — the field-encrypted-column pattern needs one row per
/// fact). The user transcribes the Jahreskaltmiete (Mieteinnahmen), the Gebäude-
/// Anschaffungskosten, the Baujahr (fixes the § 7 Abs. 4 Satz 1 EStG AfA-Satz: 2,5 %/2 %/3 %)
/// and the laufenden Werbungskosten — each honestly `offen`/`unklar`/`erfasst`, never silently
/// guessed (ADR-032); Werbungskosten may be entered as 0, but that 0 is the user's entry, never
/// a kernel-invented zero. Each field's stored string encodes its honest state
/// (packages/core/src/vermietung.ts is the ONE place that maps): `null` = `offen`, the reserved
/// marker `unklar` = "looked but could not read", any other string = a non-negative integer
/// (`erfasst`). The derived facts (Einnahme-Posten, Werbungskosten-Summe, lineare AfA with its
/// § 7 Abs. 4 Herkunft) are recomputed on every read via @steuereule/core
/// (vermietungsobjektFakten/vermietungStand), never stored (ADR-014/048 determinism boundary).
/// All four figures are field-encrypted at rest (ADR-0008): rental income and acquisition costs
/// are among the most sensitive personal facts a tax app holds, joinable to Profile's Steuer-ID
/// via the same userId.
model RentalProperty {
  id                     String   @id @default(uuid())
  /// Scoping key — same trusted userId as Profile.userId (ADR-0007). Never read from the
  /// request path/query/body.
  userId                 String
  /// The tax year these figures belong to (same granularity as Lstb/ChLohnausweis/Rente).
  taxYear                Int      @map("steuerjahr")
  /// Jahreskaltmiete (whole euros). Encrypted at rest; null=offen, "unklar"=unreadable.
  mieteinnahmen          String? /// @encrypted?mode=strict
  /// Gebäude-Anschaffungskosten (whole euros). Encrypted at rest; same encoding.
  anschaffungskosten     String? /// @encrypted?mode=strict
  /// Baujahr (Fertigstellung) — fixes the § 7 Abs. 4 Satz 1 AfA-Satz. Encrypted at rest.
  baujahr                String? /// @encrypted?mode=strict
  /// Laufende Werbungskosten (whole euros). Encrypted at rest; same encoding.
  werbungskosten         String? /// @encrypted?mode=strict
  /// Lage des Objekts für Anlage V (ADR-0050). Encrypted at rest.
  strasse                String? /// @encrypted?mode=strict
  hausnummer             String? /// @encrypted?mode=strict
  plz                    String? /// @encrypted?mode=strict
  city                   String?  @map("ort") /// @encrypted?mode=strict
  livingArea             String?  @map("wohnflaeche") /// @encrypted?mode=strict
  /// Anlage V Zeile 33: the building AfA is unchanged from last year (1 = wie Vorjahr).
  depreciationAsLastYear Boolean? @map("afaWieVorjahr")
  /// Anlage V Z. 20 Umlagen, Z. 46/48 Schuldzinsen (whole euros), Z. 13 number of flats, Z. 86 Person A's share
  /// in percent (ADR-0054). Encrypted at rest; null = not entered.
  umlagen                String? /// @encrypted?mode=strict
  schuldzinsen           String? /// @encrypted?mode=strict
  einheiten              String? /// @encrypted?mode=strict
  anteilA                String? /// @encrypted?mode=strict
  /// The object across the years (ADR-0099 §8): each year has its own row, the Jahresübernahme carries
  /// this key over. Not tax data, so not encrypted; it only groups the rows.
  propertyKey            String   @default(uuid()) @map("objektKennung")
  /// Date of purchase (ISO), for the AfA pro rata, the book value and the 15 % window.
  anschaffungsdatum      String? /// @encrypted?mode=strict
  /// Erhaltungsaufwand of the year as JSON `[{ "betrag": 4300, "datum": "2024-05-02" | null }]`, whole
  /// euros net of VAT (§ 6 Abs. 1 Nr. 1a EStG). Encrypted at rest; null = none recorded.
  erhaltungsaufwand      String? /// @encrypted?mode=strict
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([userId, taxYear])
  @@map("Vermietungsobjekt")
}

/// One row per (userId, steuerjahr) — the Steuerbescheid (Bescheidprüfung 1.0, ticket 10.3,
/// ADR-009). The Bescheid arrives as a Beleg (art `Steuerbescheid`) and its five figures are
/// transcribed field by field (guided mask, ADR-036 — Scan/OCR is OUT of scope, ADR-045); the
/// photo/PDF stays stored as the Beleg. Each figure's stored string encodes its honest state
/// (packages/core/src/bescheid.ts is the ONE place that maps): `null` = `offen` (not reached yet),
/// the reserved marker `unklar` = "looked but could not read", any other string = a whole-euro
/// amount (`erfasst`; `erstattung` is the one signed field — Nachzahlung < 0). The figures are
/// field-encrypted at rest (ADR-0008): actual income/tax figures are the most sensitive personal
/// facts a tax app holds, joinable to Profile's Steuer-ID via the same userId. The phase sub-state
/// (`status`) and the Bescheiddatum stay in the clear: the server-side transition validation and
/// the § 355 AO Fristen-Countdown need them without decrypting, and neither is a tax identifier.
model Assessment {
  id                            String   @id @default(uuid())
  /// Scoping key — same trusted userId as Profile.userId (ADR-0007). Never read from the
  /// request path/query/body.
  userId                        String
  /// The tax year these figures belong to (same granularity as Lstb/ChLohnausweis).
  taxYear                       Int      @map("steuerjahr")
  /// The bescheid-phase sub-state (eingegangen | geprüft | einspruch-eingelegt), validated on
  /// every write against @steuereule/core's istBescheidUebergangErlaubt — kein stiller Übergang.
  status                        String   @default("eingegangen")
  /// Bescheiddatum (ISO yyyy-mm-dd) — the § 355 AO Einspruchsfrist runs from here. Clear.
  assessmentDate                String?  @map("bescheiddatum")
  /// Einspruch-Grund (closed set from @steuereule/core's EINSPRUCHS_GRUENDE), null until filed.
  appealReason                  String?  @map("einspruchGrund")
  /// The day the Einspruch was lodged (ISO), and how it ended (ADR-0099 §8): offen | stattgegeben |
  /// teilweise | abgelehnt | zurueckgenommen. The amount it changed the refund by is encrypted.
  appealDate                    String?  @map("einspruchDatum")
  appealOutcome                 String?  @map("einspruchErgebnis")
  appealOutcomeAmount           String?  @map("einspruchBetrag") /// @encrypted?mode=strict
  /// Einkünfte laut Bescheid (comparable). Encrypted at rest; null=offen, "unklar"=unreadable.
  einnahmen                     String? /// @encrypted?mode=strict
  /// Vorsorgeaufwendungen laut Bescheid (comparable). Encrypted at rest.
  vorsorgeaufwand               String? /// @encrypted?mode=strict
  /// Anrechenbare Steuern (Quellensteuer) laut Bescheid (comparable). Encrypted at rest.
  anrechnung                    String? /// @encrypted?mode=strict
  /// Festgesetzte Einkommensteuer (Bescheid-only, not comparable). Encrypted at rest.
  festgesetzteSteuer            String? /// @encrypted?mode=strict
  /// Abschlusszahlung: Erstattung > 0, Nachzahlung < 0 (Bescheid-only, not comparable). Encrypted.
  erstattung                    String? /// @encrypted?mode=strict
  /// ADR-0098 §8: the Besteuerungsgrundlagen the Bescheid prints, per position (core
  /// `ASSESSMENT_POSITIONS`). Same encoding as above: null = not read, "unklar" = unreadable.
  /// A and B are the two columns of a joint Bescheid; a single Bescheid uses A.
  bruttoarbeitslohnA            String? /// @encrypted?mode=strict
  bruttoarbeitslohnB            String? /// @encrypted?mode=strict
  fahrtwegA                     String? /// @encrypted?mode=strict
  homeofficeA                   String? /// @encrypted?mode=strict
  arbeitsmittelA                String? /// @encrypted?mode=strict
  sonstigeWerbungskostenA       String? /// @encrypted?mode=strict
  werbungskostenA               String? /// @encrypted?mode=strict
  fahrtwegB                     String? /// @encrypted?mode=strict
  homeofficeB                   String? /// @encrypted?mode=strict
  arbeitsmittelB                String? /// @encrypted?mode=strict
  sonstigeWerbungskostenB       String? /// @encrypted?mode=strict
  werbungskostenB               String? /// @encrypted?mode=strict
  sonderausgaben                String? /// @encrypted?mode=strict
  aussergewoehnlicheBelastungen String? /// @encrypted?mode=strict
  zuVersteuerndesEinkommen      String? /// @encrypted?mode=strict
  steuerermaessigung35a         String? /// @encrypted?mode=strict
  solidaritaetszuschlag         String? /// @encrypted?mode=strict
  kirchensteuer                 String? /// @encrypted?mode=strict
  /// The Finanzamt's Erläuterungen as printed, one paragraph per line (quoted, never interpreted).
  erlaeuterungen                String? /// @encrypted?mode=strict
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  @@unique([userId, taxYear])
  @@index([userId])
  @@map("Bescheid")
}

/// The version of a return frozen at submission (ADR-0098 §8, core `FiledReturn`): the left side of
/// the Bescheid-Abgleich, so a change after submission does not move it. Immutable; a correction is
/// a new `number`. `positions` is the JSON of the declared positions (core `ASSESSMENT_POSITIONS`)
/// and the refund estimated at submission, encrypted at rest (ADR-0008).
model FilingVersion {
  id          String   @id @default(uuid())
  /// Scoping key (ADR-0007): the account whose return it is (Person B's own data user in a single return of B).
  userId      String
  taxYear     Int      @map("steuerjahr")
  number      Int      @default(1) @map("nummer")
  filingType  String   @map("veranlagungsart")
  /// ISO yyyy-mm-dd, the day it was submitted.
  submittedOn String   @map("eingereichtAm")
  positions   String   @map("positionen") /// @encrypted?mode=strict
  createdAt   DateTime @default(now())

  @@unique([userId, taxYear, number])
  @@index([userId])
  @@map("Fassung")
}

/// Die Kennzeichnungs-Schicht (ADR-0049, verallgemeinert durch ADR-0052 §6/§7): eine Zeile je
/// Feld, das NICHT der Nutzer selbst eingetragen hat (Jahresübernahme, Assistent, Beleg) — oder das
/// einen offenen Vorschlag trägt. Keine Zeile = vom Nutzer eingetragen = bestätigt. Die Fakten
/// selbst bleiben in ihren Modellen; Vorprüfung, Ausdruck und Bezahlung behandeln `bestaetigt =
/// false` wie offen. Ein Wert des Nutzers wird nie überschrieben: der fremde Wert landet als
/// Vorschlag (`vorschlag*`), der neueste ersetzt einen älteren.
model Marking {
  id                     String   @id @default(uuid())
  /// Scoping key — same trusted userId as Profile.userId (ADR-0007). Never read from the
  /// request path/query/body.
  userId                 String
  /// The tax year of the field; 0 for year-independent masks (Profil, Stammdaten).
  taxYear                Int      @map("steuerjahr")
  /// `<maske>[:<instanz>].<feld>`, e.g. `lstb.bruttoarbeitslohn`, `vermietung:<id>.mieteinnahmen`.
  itemKey                String   @map("postenKey")
  /// The Anlage the field is confirmed with (core `anlageVon`), kept for per-Anlage queries.
  annex                  String   @map("anlage")
  /// Herkunft of the current value: nutzer | uebernahme | assistent | beleg.
  provenanceKind         String   @map("herkunftArt")
  provenanceName         String?  @map("herkunftName")
  provenanceReceiptId    String?  @map("herkunftBelegId")
  lastYear               Int?     @map("vorjahr")
  /// The OAuth client that wrote the value (ADR-0052 amendment 4); null for rows from before, and for non-assistants.
  provenanceClientId     String?  @map("herkunftClientId")
  /// false = UNBESTÄTIGT; true = the user confirmed the Anlage or chose the value.
  confirmed              Boolean  @default(false) @map("bestaetigt")
  /// Null when there is no open proposal.
  proposalProvenanceKind String?  @map("vorschlagHerkunftArt")
  proposalProvenanceName String?  @map("vorschlagHerkunftName")
  proposalReceiptId      String?  @map("vorschlagBelegId")
  proposalLastYear       Int?     @map("vorschlagVorjahr")
  proposalClientId       String?  @map("vorschlagClientId")
  proposalValue          String?  @map("vorschlagWert") /// @encrypted?mode=strict
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([userId, taxYear, itemKey])
  @@index([userId, taxYear])
  @@map("Kennzeichnung")
}

/// Paid unlock of one tax year's Formular-Ausdruck (ADR-0050: Papierweg, paid on print).
/// One row per Stripe Checkout Session; `bezahlt` is set only by the signature-verified
/// webhook, never by the browser's return redirect. Account-only (a guest cannot pay).
/// No FK to User (P7): a paid row is a Buchungsbeleg under a legal hold (§ 147 AO, § 257 HGB)
/// and must outlive the account's deletion until the hold ends; the deletion removes every
/// row that is not held (`personal-data-registry.ts`).
model Unlock {
  id                      String    @id @default(uuid())
  userId                  String
  taxYear                 Int       @map("steuerjahr")
  /// "offen" until the webhook confirms payment, then "bezahlt"; "abgelaufen" when the session closed
  /// unpaid; "erstattet" / "angefochten" after a full refund / an opened dispute. Only "bezahlt" unlocks.
  status                  String    @default("offen")
  stripeCheckoutSessionId String    @unique
  /// Which price was paid (ADR-0101 §21): "standard" or "selbststaendig"; a year with self-employment
  /// needs "selbststaendig", which also covers everything "standard" opens.
  tier                    String    @default("standard") @map("stufe")
  amountCents             Int?      @map("betragCent")
  paidAt                  DateTime? @map("bezahltAm")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([userId, taxYear])
  @@map("Freischaltung")
}

/// Erklärungs-Stammdaten for the Hauptvordruck ESt 1 A beyond Profile's name/Steuer-ID
/// (ADR-0050: the paper return must be complete). Its own model, not Profile columns:
/// PUT /v1/profile replaces the whole profile and Onboarding uses it, so required ESt-1-A
/// fields there would break the value-first funnel (ADR-0045). Every personal field is
/// encrypted at rest; `religion` is a special category (Art. 9 DSGVO) and is stored only
/// together with the explicit consent timestamp.
model MasterData {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  geburtsdatum           String? /// @encrypted?mode=strict
  strasse                String? /// @encrypted?mode=strict
  hausnummer             String? /// @encrypted?mode=strict
  hausnummerZusatz       String? /// @encrypted?mode=strict
  plz                    String? /// @encrypted?mode=strict
  wohnort                String? /// @encrypted?mode=strict
  beruf                  String? /// @encrypted?mode=strict
  religion               String? /// @encrypted?mode=strict
  religionEinwilligungAm DateTime?
  /// Liable to church tax or not, without the confession (ADR-0052 amendment 3); the confession wins.
  kirchensteuerpflichtig Boolean?
  familienstand          String? /// @encrypted?mode=strict
  familienstandSeit      String? /// @encrypted?mode=strict
  iban                   String? /// @encrypted?mode=strict
  kontoinhaber           String? /// @encrypted?mode=strict
  finanzamt              String? /// @encrypted?mode=strict
  telefon                String? /// @encrypted?mode=strict
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@map("Stammdaten")
}

/// One row per child for a given tax year (product ADR-031, Anlage Kind, ADR-0050).
/// Personal facts are field-encrypted at rest (ADR-0008).
model Child {
  id                        String   @id @default(uuid())
  /// Scoping key — same trusted userId as Profile.userId (ADR-0007).
  userId                    String
  taxYear                   Int      @map("steuerjahr")
  sequenceNumber            Int      @default(1) @map("lfdNr")
  firstName                 String   @map("vorname") /// @encrypted?mode=strict
  lastName                  String   @map("nachname") /// @encrypted?mode=strict
  geburtsdatum              String /// @encrypted?mode=strict
  taxId                     String?  @map("idnr") /// @encrypted?mode=strict
  childBenefitClaimEur      String?  @map("kindergeldAnspruchEur") /// @encrypted?mode=strict
  /// Anlage Kind Zeile 10 (Kz 02 / Kz 03): 1 = leiblich/adoptiert, 2 = Pflegekind, 3 = Enkel-/Stiefkind.
  kinship                   String?  @map("kindschaftsverhaeltnis")
  kinshipB                  String?  @map("kindschaftsverhaeltnisB")
  familyBenefitsOffice      String?  @map("familienkasse") /// @encrypted?mode=strict
  domesticResidenceAllYear  Boolean? @map("wohnsitzInlandGanzjaehrig")
  /// Anlage Kind Zeilen 11–15: the other parent when not part of this return.
  otherParent               String?  @map("andererElternteil")
  otherParentName           String?  @map("andererElternteilName") /// @encrypted?mode=strict
  otherParentBirthDate      String?  @map("andererElternteilGeburtsdatum") /// @encrypted?mode=strict
  otherParentAddress        String?  @map("andererElternteilAdresse") /// @encrypted?mode=strict
  otherParentKind           String?  @map("andererElternteilArt")
  otherParentDiedOn         String?  @map("andererElternteilVerstorbenAm") /// @encrypted?mode=strict
  /// Entlastungsbetrag für Alleinerziehende (Anlage Kind Zeilen 45/46), whole year only.
  registeredWithMeAllYear   Boolean? @map("gemeldetBeiMirGanzjaehrig")
  childBenefitToMeAllYear   Boolean? @map("kindergeldAnMichGanzjaehrig")
  /// Anlage Kind Zeilen 27/28 (Kz 66/67): the child's KV Basisabsicherung and PV, paid by the parents as
  /// policyholders; whole euros, null = not entered.
  healthBasicEur            String?  @map("kvBasisEur") /// @encrypted?mode=strict
  careEur                   String?  @map("pvEur") /// @encrypted?mode=strict
  /// Anlage Kind Zeile 6 (Kz 15): Schweizer Kinderzulage / Familienzulage in whole EUR (converted from Lohnausweis).
  swissFamilyAllowanceEur   String?  @map("schweizerKinderzulageEur") /// @encrypted?mode=strict
  /// Anlage Kind Zeile 67 (Kz 51): childcare paid by the parents in whole euros, the kind of service with
  /// the provider's name and address, and the period (DD.MM.YYYY); null = not entered.
  childcareEur              String?  @map("betreuungEur") /// @encrypted?mode=strict
  childcareProvider         String?  @map("betreuungDienstleister") /// @encrypted?mode=strict
  childcareFrom             String?  @map("betreuungVon") /// @encrypted?mode=strict
  childcareTo               String?  @map("betreuungBis") /// @encrypted?mode=strict
  /// Who receives the Swiss Kinderzulage with their wage: "A" or "B" (ADR-0088).
  swissFamilyAllowancePayer String?  @map("schweizerKinderzulageVon")
  /// The child's health insurance is foreign (e.g. Swiss basic insurance): Anlage Kind Kz 89 (ADR-0090).
  healthInsuranceAbroad     Boolean? @map("kvAusland")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([userId, taxYear])
  @@map("Kind")
}

/// Coupling of two tax years for joint filing (ADR-006, Zusammenveranlagung).
model TaxYearLink {
  id                       String    @id @default(uuid())
  personAUserId            String
  personBUserId            String
  taxYear                  Int       @map("steuerjahr")
  filingType               String    @default("zusammen") @map("veranlagungsart")
  invitationCode           String?   @unique @map("einladungsCode")
  /// The invite code links two accounts; it stops working after this moment.
  invitationCodeValidUntil DateTime? @map("einladungsCodeGueltigBis")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@unique([personAUserId, taxYear])
  @@index([personBUserId, taxYear])
  @@map("SteuerjahrKopplung")
}

/// A spouse or child kept once per household (ADR-0062, #452). The household belongs to the account of
/// person A (`householdUserId`). Stable facts (names, birth date, Steuer-ID, date of death) live in
/// `sealed`, encrypted under the person's own key in the keystore (`household-person:<id>`, ADR-0059):
/// destroying that key makes them unreadable everywhere (crypto-shredding per person).
model HouseholdPerson {
  id              String   @id @default(uuid())
  householdUserId String   @map("haushaltNutzerId")
  /// 'spouse' | 'child'
  kind            String   @map("art")
  sealed          String   @map("versiegelt")
  /// Spouse with an own account (set when the invitation was redeemed once).
  linkedUserId    String?  @map("verknuepftesKonto")
  /// "Ab Jahr X nicht mehr dabei": membership ends with this year; earlier years stay.
  leftFromYear    Int?     @map("nichtMehrDabeiAb")
  updatedByUserId String   @map("geaendertVon")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships TaxYearMembership[]

  @@index([householdUserId])
  @@map("HaushaltPerson")
}

/// Person × tax year (ADR-0062). The yearly facts stay in the year's record the calculation reads:
/// the Kind row (`childId`) or the spouse of the year's SteuerjahrKopplung (`spouseUserId`).
model TaxYearMembership {
  id           String          @id @default(uuid())
  personId     String          @map("personId")
  person       HouseholdPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  taxYear      Int             @map("steuerjahr")
  childId      String?         @unique @map("kindId")
  spouseUserId String?         @map("partnerNutzerId")
  createdAt    DateTime        @default(now())

  @@unique([personId, taxYear])
  @@index([taxYear])
  @@map("HaushaltJahr")
}

/// The spouse link without a year (ADR-0062 §3): valid from `validFromYear` until a partner ends it
/// with `endedFromYear`. It survives a change of the Veranlagungsart, which stays per year.
model PartnerLink {
  id             String   @id @default(uuid())
  personAUserId  String   @unique @map("personANutzerId")
  /// Own account of person B, or '' while B has none.
  personBUserId  String   @default("") @map("personBNutzerId")
  spousePersonId String?  @map("partnerPersonId")
  validFromYear  Int      @map("gueltigAb")
  endedFromYear  Int?     @map("beendetAb")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([personBUserId])
  @@map("PartnerVerknuepfung")
}

/// Two household people that look alike but are not the same (ADR-0062 §5): asked once.
model HouseholdMergeCandidate {
  id              String    @id @default(uuid())
  householdUserId String    @map("haushaltNutzerId")
  personId        String    @map("personId")
  otherPersonId   String    @map("anderePersonId")
  /// null = not yet answered, 'same' = merged, 'different' = kept apart
  resolution      String?   @map("antwort")
  resolvedAt      DateTime? @map("beantwortetAm")
  createdAt       DateTime  @default(now())

  @@unique([personId, otherPersonId])
  @@index([householdUserId])
  @@map("HaushaltDublette")
}

/// Opt-in setting and consent for Eulen-Modus (product ADR-037, ADR-048).
model OwlSetting {
  id        String    @id @default(uuid())
  userId    String    @unique
  enabled   Boolean   @default(false) @map("aktiviert")
  enabledAt DateTime? @map("aktiviertAm")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("EulenEinstellung")
}

/// The user's consent that personal data (names, Steuer-ID, birth dates, addresses, IBAN, religion as a
/// special category under Art. 9 DSGVO) may go to the language model of the owl, so it can fill those
/// fields too (ADR-0091). One row per user; `version` is the consent text agreed to, a revocation sets
/// `revokedAt` and keeps the row as the record of when consent was given and taken back. No personal
/// data in it, only the decision and its timestamps.
model OwlPersonalDataConsent {
  id        String    @id @default(uuid())
  userId    String    @unique
  version   String    @map("version")
  grantedAt DateTime  @map("erteiltAm")
  revokedAt DateTime? @map("widerrufenAm")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("EulenPersonendatenEinwilligung")
}

/// Dismissed cards in Eulen-Modus (product ADR-041: "Stimmt nicht").
model OwlCardDismissal {
  id          String   @id @default(uuid())
  userId      String
  taxYear     Int      @map("steuerjahr")
  fingerprint String
  dismissedAt DateTime @default(now()) @map("verworfenAm")

  @@unique([userId, taxYear, fingerprint])
  @@index([userId, taxYear])
  @@map("EulenKartenVerwurf")
}

/// Tracks completed Jahresübernahmen per (userId, steuerjahr) to prevent duplicate takeovers
/// even if all copied fields are later edited or confirmed by the user (ADR-0049 / ADR-0052).
model YearTakeover {
  id        String   @id @default(uuid())
  userId    String
  taxYear   Int      @map("steuerjahr")
  lastYear  Int      @map("vorjahr")
  createdAt DateTime @default(now())

  @@unique([userId, taxYear])
  @@index([userId, taxYear])
  @@map("Jahresuebernahme")
}

/// OAuth 2.1 Provider models for Better Auth (ADR-0052 §4)
model OauthClient {
  id                               String    @id @default(uuid())
  clientId                         String    @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?  @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  clientCredentialsScopes          String[]  @default([])
  userId                           String?
  user                             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime? @default(now())
  updatedAt                        DateTime? @updatedAt
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?  @default(false)
  referenceId                      String?
  metadata                         Json?

  consents        OauthConsent[]
  accessTokens    OauthAccessToken[]
  refreshTokens   OauthRefreshToken[]
  clientResources OauthClientResource[]

  @@index([userId])
}

model OauthResource {
  id                            String    @id @default(uuid())
  identifier                    String    @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?  @default(false)
  disabled                      Boolean?  @default(false)
  createdAt                     DateTime? @default(now())
  updatedAt                     DateTime? @updatedAt
  policyVersion                 Int?      @default(1)
  metadata                      Json?

  clientResources OauthClientResource[]
}

model OauthClientResource {
  id         String        @id @default(uuid())
  clientId   String
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String
  resource   OauthResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  metadata   Json?
  createdAt  DateTime?     @default(now())

  @@index([clientId])
  @@index([resourceId])
}

model OauthRefreshToken {
  id                      String      @id @default(uuid())
  token                   String      @unique
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  expiresAt               DateTime?
  createdAt               DateTime?   @default(now())
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]

  accessTokens OauthAccessToken[]

  @@index([clientId])
  @@index([userId])
  @@index([sessionId])
  @@index([authorizationCodeId])
}

model OauthAccessToken {
  id                      String             @id @default(uuid())
  token                   String?            @unique
  clientId                String
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  refreshId               String?
  refreshToken            OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: SetNull)
  expiresAt               DateTime?
  createdAt               DateTime?          @default(now())
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  @@index([clientId])
  @@index([userId])
  @@index([sessionId])
  @@index([refreshId])
  @@index([authorizationCodeId])
}

model OauthConsent {
  id                      String      @id @default(uuid())
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String[]
  requestedUserInfoClaims String[]
  scopes                  String[]
  createdAt               DateTime?   @default(now())
  updatedAt               DateTime?   @updatedAt

  @@index([clientId])
  @@index([userId])
}

model OauthClientAssertion {
  id        String   @id @default(uuid())
  expiresAt DateTime
}

/// JWKS keys for JWT signing (better-auth jwt plugin, required by oauthProvider)
model Jwks {
  id         String    @id @default(uuid())
  publicKey  String
  privateKey String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  alg        String?
  crv        String?
}

/// One row per (userId, steuerjahr) — the commute facts for the Entfernungspauschale (Anlage N
/// Zeilen 27–31): which weekdays are worked, days off, the one-way distance and how it is travelled.
model Commute {
  id                           String   @id @default(uuid())
  /// Scoping key — same trusted userId as Lstb.userId (ADR-0007).
  userId                       String
  taxYear                      Int      @map("steuerjahr")
  /// ISO weekdays worked, comma-separated ("1,2,3,4,5").
  workdays                     String   @map("arbeitstage")
  vacationDays                 Int      @default(0) @map("urlaubstage")
  sickDays                     Int      @default(0) @map("krankheitstage")
  homeOfficeDays               Int      @default(0) @map("homeofficeTage")
  /// One-way distance in full kilometres; null = not entered yet.
  oneWayKm                     Int?     @map("einfacheKm")
  /// "pkw" | "oepnv" | "andere"; null = not entered yet.
  transport                    String?  @map("verkehrsmittel")
  /// PLZ, Ort und Straße der ersten Tätigkeitsstätte. Encrypted at rest (ADR-0008).
  workplace                    String?  @map("taetigkeitsstaette") /// @encrypted?mode=strict
  /// Confirmed public holidays on working days (F4) and the state / canton they were suggested for. Clear —
  /// a count and a region code.
  publicHolidays               Int?     @map("feiertage")
  publicHolidayRegion          String?  @map("feiertageRegion")
  /// The period of this way to work (DD.MM.YYYY) when it did not last the whole year; a change of
  /// job brings a second way with its own period (ADR-0079).
  periodFrom                   String?  @map("zeitraumVon")
  periodTo                     String?  @map("zeitraumBis")
  secondOneWayKm               Int?     @map("zweiterWegKm")
  secondTransport              String?  @map("zweiterWegVerkehrsmittel")
  secondWorkplace              String?  @map("zweiterWegOrt") /// @encrypted?mode=strict
  secondFrom                   String?  @map("zweiterWegVon")
  secondTo                     String?  @map("zweiterWegBis")
  /// Days the first place of work was actually visited, per way; they replace the derived days (ADR-0093).
  travelDays                   Int?     @map("fahrtage")
  secondTravelDays             Int?     @map("zweiterWegFahrtage")
  /// The user confirmed the distance is the shortest road connection (§ 9 Abs. 1 Nr. 4 Satz 4 EStG).
  shortestRouteConfirmed       Boolean? @map("kuerzesteStreckeBestaetigt")
  secondShortestRouteConfirmed Boolean? @map("zweiterWegKuerzesteStreckeBestaetigt")
  /// Further Werbungskosten of this person (Anlage N / N-Gre), whole euros; null = not entered.
  /// Zeile 53 / 48 (Kz 310): professional bodies, e.g. a trade union.
  professionalBodiesEur        String?  @map("berufsverbaendeEur") /// @encrypted?mode=strict
  professionalBodiesNote       String?  @map("berufsverbaendeArt") /// @encrypted?mode=strict
  /// Zeilen 54–56 / 49–51 (Kz 320): work tools and typical work clothing, and what they were.
  workEquipmentEur             String?  @map("arbeitsmittelEur") /// @encrypted?mode=strict
  workEquipmentNote            String?  @map("arbeitsmittelArt") /// @encrypted?mode=strict
  /// Zeilen 62–64 / 57–59 (Kz 380): account fees, and any other Werbungskosten with what they were.
  accountFeesEur               String?  @map("kontofuehrungEur") /// @encrypted?mode=strict
  otherWorkExpensesEur         String?  @map("sonstigeWerbungskostenEur") /// @encrypted?mode=strict
  otherWorkExpensesNote        String?  @map("sonstigeWerbungskostenArt") /// @encrypted?mode=strict
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@unique([userId, taxYear])
  @@map("Arbeitsweg")
}

/// Encrypted chat history and pending/applied action proposals for the In-App Steuerberater
/// Agent ("Deine Eule", product ADR-037 / ADR-048 / ADR-0052). Both the message text (`content`)
/// and the structured action/choices metadata (`metaJson`) are field-encrypted at rest (ADR-0008).
model AdvisorChatMessage {
  id             String               @id @default(uuid())
  userId         String
  taxYear        Int                  @map("steuerjahr")
  role           String               @map("rolle")
  content        String               @map("inhalt") /// @encrypted?mode=strict
  metaJson       String?              @map("metaDaten") /// @encrypted?mode=strict
  createdAt      DateTime             @default(now())
  /// Lifecycle of the message (#476): streaming, complete, aborted or failed.
  status         String               @default("complete")
  /// Reasoning summary the provider returned for this answer, field-encrypted like the text.
  reasoning      String?              @map("gedankengang") /// @encrypted?mode=strict
  /// The run that produces this answer; lets a client re-attach while status is streaming.
  runId          String?              @map("laufId")
  feedbackRating String?              @map("bewertung")
  feedbackReason String?              @map("bewertungGrund")
  /// Token counts, timings and trace id of the turn as JSON. No message content.
  usageJson      String?              @map("verbrauch")
  /// The conversation this message belongs to (#481). Nullable only for the migration's sake:
  /// every message written by the app carries one.
  conversationId String?              @map("gespraechId")
  conversation   AdvisorConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, taxYear, createdAt])
  @@index([conversationId, createdAt])
  @@map("BeraterNachricht")
}

/// One conversation with the owl (#481). The tax return of a year is the project; it holds any
/// number of conversations, which all see the same return but not each other's messages.
model AdvisorConversation {
  id           String               @id @default(uuid())
  userId       String
  taxYear      Int                  @map("steuerjahr")
  /// From the user's first question, so field-encrypted like the messages. Null until then.
  title        String?              @map("titel") /// @encrypted?mode=strict
  createdAt    DateTime             @default(now())
  lastUsedAt   DateTime             @default(now()) @map("zuletztBenutzt")
  /// What the older part of the conversation said, once its context was full. The model reads this
  /// instead of the messages up to `summaryUntil`; the user still sees every message.
  summary      String?              @map("zusammenfassung") /// @encrypted?mode=strict
  summaryUntil DateTime?            @map("zusammengefasstBis")
  /// The chat model the user picked for this conversation, "provider:model" (ADR-0094). Null = the operator's.
  chatModel    String?              @map("modell")
  messages     AdvisorChatMessage[]

  @@index([userId, taxYear, lastUsedAt])
  @@map("BeraterGespraech")
}

/// A project note of one tax year (#481): something settled in a conversation that is no value of
/// the return. Every conversation of the year reads the notes; the owl keeps them itself.
model AdvisorNote {
  id        String   @id @default(uuid())
  userId    String
  taxYear   Int      @map("steuerjahr")
  text      String   @map("inhalt") /// @encrypted?mode=strict
  /// Who wrote the current text: the owl, or the user by editing it.
  author    String   @default("owl") @map("verfasser")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @map("geaendertAm")

  @@index([userId, taxYear, createdAt])
  @@map("BeraterNotiz")
}

// A task the user's own assistant (MCP, ADR-0052) leaves for the user: something only the user can
// do in the app (enter the confession, give a consent, confirm entries). Shown in the Cockpit until
// the user settles or discards it. The text is free text an external model wrote: encrypted, and
// checked for identifiers before it is stored. No FK to User, like every tax-data table: the account
// deletion erases it through `taxDataTables`, so a legal hold keeps it.
model AssistantTask {
  id        String    @id @default(uuid())
  userId    String
  taxYear   Int       @map("steuerjahr")
  /// One of ASSISTANT_TASK_KINDS (assistant-task.repository.ts).
  kind      String    @map("art")
  text      String    @map("inhalt") /// @encrypted?mode=strict
  /// The client name of the assistant that left the task, as the user reads it.
  assistant String    @map("assistent")
  /// The OAuth client that left it: what "its own tasks" goes by (ADR-0052 amendment 4).
  clientId  String    @map("clientId")
  /// 'offen' | 'erledigt' | 'verworfen'
  status    String    @default("offen")
  createdAt DateTime  @default(now())
  decidedAt DateTime? @map("entschiedenAm")

  @@index([userId, taxYear])
  @@map("AssistentAufgabe")
}

// Where the Berater-Interview stands for one tax year: which areas of the checklist are settled
// (`done`) or do not apply. Kept by the app so the interview neither asks twice nor stops early,
// whatever the model remembers. Encrypted: "kinder: not_applicable" says something about the household.
model AdvisorInterview {
  id        String   @id @default(uuid())
  userId    String
  taxYear   Int      @map("steuerjahr")
  progress  String   @map("stand") /// @encrypted?mode=strict
  updatedAt DateTime @default(now()) @map("geaendertAm")

  @@unique([userId, taxYear])
  @@map("BeraterInterview")
}

// The user's own description of the household's situation (#501): one text per user, read by the
// owl in every conversation of every tax year. Names and identifiers are refused when it is saved.
model AdvisorSituation {
  id        String   @id @default(uuid())
  userId    String   @unique
  text      String   @map("inhalt") /// @encrypted?mode=strict
  updatedAt DateTime @default(now()) @map("geaendertAm")

  @@map("BeraterSituation")
}

// AES-256-GCM envelope-encrypted original receipt files (PDF/JPEG/PNG/WebP).
// Binary cipherBytes/iv/authTag use the per-user DEK from the keystore database (ADR-0059)
// + AAD (userId:receiptId). contentMac is an HMAC under that DEK, never a plain hash.
model ReceiptFile {
  id          String   @id @default(uuid())
  receiptId   String   @unique @map("belegId")
  userId      String
  mimeType    String
  byteLength  Int      @map("dateigroesse")
  contentMac  String   @map("inhaltsMac")
  iv          Bytes
  authTag     Bytes
  cipherBytes Bytes    @map("verschluesselteDaten")
  keyVersion  Int      @default(1)
  createdAt   DateTime @default(now())
  receipt     Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("BelegDatei")
}

// --- Selbstständige (ADR-0101) ---------------------------------------------------
// One book per person and tax year. Entries, their lines and the log are append-only: a trigger in
// migration 20261120100000_self_employment rejects UPDATE and DELETE on them (GoBD); account deletion
// sets a transaction-local erasure flag the trigger lets through (Art. 17, delete-account-transaction.ts).
// Amounts, texts, names, references and IBANs are field-encrypted like their neighbours (ADR-0008);
// structure (account numbers, sides, tax keys, dates, numbers, hashes) stays in the clear because the
// trigger, the uniqueness of numbers and the hash chain need it. Hashes are computed over the
// plaintext, so the chain does not depend on the encryption.

/// The business of one person in one tax year: Freiberuf or Gewerbe, how the profit is determined,
/// the VAT and trade tax facts the user enters (ADR-0101 §2, §5, §8, §9, §10, §3).
model BusinessProfile {
  id                 String   @id @default(uuid())
  /// Scoping key — same trusted userId as Profile.userId (ADR-0007).
  userId             String
  taxYear            Int      @map("steuerjahr")
  /// "A" (the account holder) or "B" (the spouse recorded in this account).
  person             String   @default("A")
  /// The business of this person, from 1 (ADR-0101 §22): a Freiberuf beside a Gewerbe, two Gewerbebetriebe.
  business           Int      @default(1) @map("betrieb")
  /// The confirmed kind: "freiberuf" or "gewerbe"; null until the user confirmed the suggestion.
  kind               String?  @map("art")
  /// The answers to the profession questions as JSON (core ProfessionAnswers).
  professionAnswers  String?  @map("berufsAngaben") /// @encrypted?mode=strict
  /// The core's suggestion with its reasons as JSON, kept with the answers it came from.
  suggestion         String?  @map("vorschlag") /// @encrypted?mode=strict
  /// Name of the business as the user calls it.
  name               String?  @map("bezeichnung") /// @encrypted?mode=strict
  /// "euer" or "bilanz".
  mode               String   @default("euer") @map("gewinnermittlung")
  /// "SKR03" or "SKR04".
  chart              String   @default("SKR03") @map("kontenrahmen")
  smallBusiness      Boolean  @default(false) @map("kleinunternehmer")
  /// "ist" or "soll" (§ 13 Abs. 1 Nr. 1 UStG).
  vatMethod          String   @default("ist") @map("versteuerung")
  /// Amtlicher Gemeindeschlüssel of the Betriebsstätte.
  municipalityAgs    String?  @map("gemeindeAgs") /// @encrypted?mode=strict
  /// The Hebesatz the user set instead of the table's, in percent.
  multiplierOverride String?  @map("hebesatzKorrektur") /// @encrypted?mode=strict
  /// Start of the business (ISO date).
  startDate          String?  @map("beginn") /// @encrypted?mode=strict
  /// Umsatzsteuer prepayments of the year as one sum in cents (ADR-0101 §8).
  vatPrepayments     String?  @map("ustVorauszahlungen") /// @encrypted?mode=strict
  /// The Voranmeldung facts as JSON (ADR-0101 §22): period chosen or set by the office, Dauerfristverlängerung, Sondervorauszahlung.
  vatPeriodFacts     String?  @map("ustVaAngaben") /// @encrypted?mode=strict
  /// Sale or giving up of the business as JSON (§ 16, § 34 EStG; ADR-0101 §22).
  disposalFacts      String?  @map("veraeusserung") /// @encrypted?mode=strict
  /// The Thesaurierung of a Bilanzierer as JSON (§ 34a EStG; ADR-0101 §22).
  retainedFacts      String?  @map("thesaurierung") /// @encrypted?mode=strict
  /// Gewerbesteuer inputs as JSON: § 8 Nr. 1 components, § 9 Nr. 1, other additions and deductions, Gewerbeverlust.
  tradeTaxInputs     String?  @map("gewstAngaben") /// @encrypted?mode=strict
  /// Loss facts as JSON: Verlustvortrag from the last Feststellungsbescheid, the Rücktrag waiver.
  lossFacts          String?  @map("verlustAngaben") /// @encrypted?mode=strict
  /// Shares from partnerships as JSON (amounts of their Feststellungsbescheid, ADR-0101 §3).
  partnershipShares  String?  @map("beteiligungen") /// @encrypted?mode=strict
  /// The values of the Verfahrensdokumentation as JSON.
  procedureDoc       String?  @map("verfahrensdoku") /// @encrypted?mode=strict
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, taxYear, person, business])
  @@index([userId, taxYear])
  @@map("Betrieb")
}

/// The book (ADR-0101 §11): chart, mode and the Festschreibung, which only moves forward (trigger).
model Ledger {
  id               String            @id @default(uuid())
  userId           String
  taxYear          Int               @map("steuerjahr")
  person           String            @default("A")
  /// The business the book belongs to (ADR-0101 §22): one book per business.
  business         Int               @default(1) @map("betrieb")
  chart            String            @map("kontenrahmen")
  mode             String            @map("gewinnermittlung")
  /// Festschreibung: no entry dated on or before this ISO date.
  lockedThrough    String?           @map("festgeschriebenBis")
  createdAt        DateTime          @default(now())
  entries          JournalEntry[]
  logRecords       LedgerLogRecord[]
  bankTransactions BankTransaction[]

  @@unique([userId, taxYear, person, business])
  @@index([userId, taxYear])
  @@map("Buch")
}

/// One journal entry, never changed (append-only trigger); a correction is a Storno entry.
model JournalEntry {
  id             String        @id @default(uuid())
  ledgerId       String        @map("buchId")
  userId         String
  taxYear        Int           @map("steuerjahr")
  /// Gapless per book, from 1.
  number         Int           @map("nummer")
  date           String        @map("datum")
  documentNumber String        @map("belegnummer") /// @encrypted?mode=strict
  receiptRef     String?       @map("belegverweis") /// @encrypted?mode=strict
  text           String        @map("buchungstext") /// @encrypted?mode=strict
  /// The § 11 EStG facts of a regular payment as JSON.
  regularPayment String?       @map("wiederkehrend") /// @encrypted?mode=strict
  reversalOf     Int?          @map("stornoVon")
  /// The counterparty's foreign VAT id for the Zusammenfassende Meldung (ADR-0101 §22); null when none.
  counterpartyVatId String?    @map("ustIdNr") /// @encrypted?mode=strict
  /// Where the entry came from: "nutzer", "eule:<ref>", "bank:<id>", "beleg:<id>", "afa:<id>", "eb". No tax data.
  source         String        @default("nutzer") @map("herkunft")
  /// The accepted draft as JSON when the entry came from one (owl, receipt): what the draft's undo compares.
  draft          String?       @map("entwurf") /// @encrypted?mode=strict
  /// SHA-256 over the canonical plaintext of the entry.
  contentHash    String        @map("inhaltHash")
  createdAt      DateTime      @default(now())
  ledger         Ledger        @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  lines          JournalLine[]

  @@unique([ledgerId, number])
  @@index([userId, taxYear])
  @@map("Buchung")
}

/// One line of an entry as the ledger expanded it (VAT lines included), never changed.
model JournalLine {
  id       String       @id @default(uuid())
  entryId  String       @map("buchungId")
  userId   String
  taxYear  Int          @map("steuerjahr")
  position Int          @map("zeile")
  account  String       @map("konto")
  /// "debit" or "credit".
  side     String       @map("seite")
  /// Cents as a decimal string.
  amount   String       @map("betrag") /// @encrypted?mode=strict
  taxKey   String       @map("steuerschluessel")
  /// "base", "tax" or null.
  taxPart  String?      @map("steueranteil")
  entry    JournalEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@unique([entryId, position])
  @@index([userId, taxYear])
  @@map("Buchungszeile")
}

/// The hash-chained log of the book (GoBD Rz. 107 ff.): entries, locks and exports, never changed.
model LedgerLogRecord {
  id       String @id @default(uuid())
  ledgerId String @map("buchId")
  userId   String
  taxYear  Int    @map("steuerjahr")
  seq      Int    @map("lfdNr")
  /// ISO timestamp the API stamped; part of the hashed content.
  at       String @map("zeitpunkt")
  /// "entry", "lock" or "export".
  kind     String @map("art")
  /// Canonical JSON of the payload.
  payload  String @map("inhalt") /// @encrypted?mode=strict
  prevHash String @map("vorgaengerHash")
  hash     String
  ledger   Ledger @relation(fields: [ledgerId], references: [id], onDelete: Restrict)

  @@unique([ledgerId, seq])
  @@index([userId, taxYear])
  @@map("Buchungsprotokoll")
}

/// A fixed asset of the business; the depreciation is computed by the core from these facts.
model FixedAsset {
  id                  String   @id @default(uuid())
  userId              String
  /// The year of acquisition: the asset is listed in that year and every later one.
  taxYear             Int      @map("steuerjahr")
  person              String   @default("A")
  business            Int      @default(1) @map("betrieb")
  label               String   @map("bezeichnung") /// @encrypted?mode=strict
  /// The asset account in the book's chart.
  account             String   @map("konto")
  acquisitionDate     String   @map("anschaffungsdatum") /// @encrypted?mode=strict
  /// Net cost in cents.
  acquisitionCost     String   @map("anschaffungskosten") /// @encrypted?mode=strict
  /// "linear", "degressive", "gwg", "sofort", "building".
  method              String   @map("methode")
  category            String?  @map("anlagenart")
  usefulLifeYears     Int?     @map("nutzungsdauer")
  /// The Sonder-AfA (§ 7g Abs. 5) per year as JSON, and the cut of the cost (§ 7g Abs. 2).
  specialDepreciation String?  @map("sonderAfa") /// @encrypted?mode=strict
  /// Disposal as JSON: date and proceeds in cents.
  disposal            String?  @map("abgang") /// @encrypted?mode=strict
  /// A building's facts as JSON (§ 7 Abs. 4, 5a EStG): use, completion, Bauantrag, construction start, contract.
  buildingFacts       String?  @map("gebaeude") /// @encrypted?mode=strict
  /// The Vorsteuerberichtigung as JSON (§ 15a UStG): input VAT in cents, original share, share by year.
  vatCorrection       String?  @map("vorsteuerberichtigung") /// @encrypted?mode=strict
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId, taxYear])
  @@map("Anlagegut")
}

/// A transaction from an imported statement; the fingerprint keeps a re-import from doubling it.
model BankTransaction {
  id          String   @id @default(uuid())
  ledgerId    String   @map("buchId")
  userId      String
  taxYear     Int      @map("steuerjahr")
  /// SHA-256 of the core (withFingerprints), unique per book.
  fingerprint String   @map("fingerabdruck")
  /// Signed cents.
  amount      String   @map("betrag") /// @encrypted?mode=strict
  /// Date, counterparty, IBAN and reference as JSON.
  details     String   @map("angaben") /// @encrypted?mode=strict
  /// "offen", "gebucht" or "ignoriert".
  status      String   @default("offen")
  entryNumber Int?     @map("buchungNummer")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ledger      Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Restrict)

  @@unique([ledgerId, fingerprint])
  @@index([userId, taxYear])
  @@map("Kontoumsatz")
}

/// A rule the bank import suggests bookings with (core BookingRule); per person, across years.
model BookingRule {
  id        String   @id @default(uuid())
  userId    String
  person    String   @default("A")
  /// The matching criteria as JSON (IBAN, name, reference, direction).
  criteria  String   @map("kriterien") /// @encrypted?mode=strict
  account   String   @map("konto")
  taxKey    String   @map("steuerschluessel")
  text      String?  @map("buchungstext") /// @encrypted?mode=strict
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("Buchungsregel")
}

/// One payroll run of an employee of the business (ADR-0101 §22): the amounts of the outside payroll, or a
/// Minijob the app computed; the Lohnsteuer-Anmeldung sums them. Booked as one entry (entryNumber).
model PayrollRun {
  id          String   @id @default(uuid())
  userId      String
  taxYear     Int      @map("steuerjahr")
  person      String   @default("A")
  business    Int      @default(1) @map("betrieb")
  /// 1–12.
  month       Int      @map("monat")
  /// "regulaer" or "minijob".
  kind        String   @map("art")
  /// The employee's name as the user calls them.
  employee    String   @map("arbeitnehmer") /// @encrypted?mode=strict
  /// The amounts as JSON (gross, wage tax, Soli, church tax and kind, social security shares).
  amounts     String   @map("betraege") /// @encrypted?mode=strict
  entryNumber Int?     @map("buchungsnummer")
  createdAt   DateTime @default(now())

  @@index([userId, taxYear, person, business])
  @@map("Lohnlauf")
}

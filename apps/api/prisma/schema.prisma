// Prisma schema for the Onboarding Profile (steuereule#29).
// Managed EU Postgres, expand-only versioned migrations (ADR-047).
//
// !! The string `@encrypted` must NEVER appear in a FIELD's `///` doc comment except
// !! as the annotation itself (and likewise `@encryption:hash(...)` / `@encryption:cursor`).
// !! prisma-field-encryption's own regex is unanchored and reads a field's ENTIRE
// !! doc string — a comment that merely mentions `@encrypted` while explaining that a
// !! field is NOT encrypted silently becomes the annotation and encrypts the column
// !! (#325; verified in the installed prisma-field-encryption@1.6.0, dist/dmmf.js:78).
// !! Scoped to FIELD doc comments deliberately: analyseDMMF only ever reads
// !! `field.documentation` — a model's own `///` doc block (e.g. TaxYear's, below,
// !! which discusses `@encrypted` in prose) is never parsed, so the same string there
// !! is inert. If you need to explain an encryption decision in prose on a FIELD,
// !! write a plain `//` comment instead — Prisma's DMMF (and therefore this regex)
// !! never sees `//`; InterviewAnswer.questionId's comment below is the exemplar.
// !! `test/prisma-encrypted-fields.test.ts` asserts the actual encrypted/hashed field
// !! set (derived from `Prisma.dmmf`, not from this comment text) against a checked-in
// !! expected list — update that list in the same commit as any intentional change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One row per userId (guest session or real account, ADR-0007). Plain persisted
/// facts collected during Onboarding — no derived values, clean side of the
/// determinism boundary (ADR-014/048); @steuereule/core never recomputes these.
model Profile {
  id           String   @id @default(uuid())
  /// Scoping key. Never read from the request body/query/path — only ever set
  /// from the trusted userId the UserContextGuard produced (ADR-0007).
  userId       String   @unique
  firstName    String
  lastName     String
  /// Steuerliche Identifikationsnummer — exactly 11 digits (validated server-side
  /// via @steuereule/core's isValidSteuerId before this is ever written).
  /// Field-encrypted at rest (ADR-0008, prisma-field-encryption, AES-256-GCM,
  /// randomized nonce per write — ciphertext is longer than the plaintext digit
  /// string, so the column stays `String`, no type migration needed). `mode=strict`
  /// so a tampered/corrupted ciphertext throws on read instead of silently passing
  /// through as clear text or null (REQ-003.5) — safe once every existing row is
  /// encrypted, which is true from this migration onward.
  steuerId     String /// @encrypted?mode=strict
  /// Optional — 1-13 digits if present (isValidSteuernummer). Field-encrypted at
  /// rest for the same reason as steuerId.
  steuernummer String? /// @encrypted?mode=strict
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Append-only audit trail of who touched a user's sensitive tax/profile fields, and
/// when (ADR-0008, REQ-004, DSGVO Art. 30 accountability). Deliberately carries no
/// value column — not the plaintext, not the ciphertext — only who/what/when. Never
/// updated or deleted at the application layer (no repository method exposes
/// anything but append); DB-level (role/trigger) enforcement is a follow-up.
model TaxDataAccessLog {
  id        String      @id @default(uuid())
  /// Scoping key — same trusted userId as Profile.userId (ADR-0007). Never joined
  /// across users; every read of this table is scoped to a single userId.
  userId    String
  action    AuditAction
  /// The resource/field-class touched, e.g. "profile". A short discriminator, never
  /// the sensitive value itself.
  resource  String
  createdAt DateTime    @default(now())

  @@index([userId])
}

enum AuditAction {
  READ
  WRITE
}

// --- better-auth tables (ADR-0009/ADR-0012 §3) --------------------------------
// New tables only — a pure expand-only migration. None of these touch Profile or
// TaxDataAccessLog. Field/table shapes follow better-auth's own canonical Prisma
// schema (the shape its Prisma adapter queries against unconditionally) so no
// custom `modelName`/field-mapping config is needed on the betterAuth() side —
// Prisma's client property for each model is just its lowerCamelCase name
// (`prisma.user`, `prisma.session`, ...), which is exactly the model identifier
// the adapter looks up. better-auth's own `id` values are app-generated
// (typically a random id), but `@default(uuid())` is a safe DB-side fallback,
// mirroring Profile/TaxDataAccessLog's existing convention.

/// A real account (better-auth). `id` is the same userId namespace as a guest
/// session's opaque uuid (ADR-0012 §3) — Profile.userId holds either without a
/// type change, and REQ-006's guest->account upgrade just re-keys the FK value.
model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  /// Opt-in TOTP 2FA flag (REQ-007). Written only by better-auth's `two-factor`
  /// plugin (`enableTwoFactor`/`disableTwoFactor` set it, `verifyTOTP` flips it true
  /// after the one-code confirmation), never by this app's own controllers — the
  /// plugin owns the field exactly as it owns `twoFactor.secret`.
  twoFactorEnabled Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  twoFactors    TwoFactor[]
  passkeys      Passkey[]
}

/// DB-backed, server-revocable session (ADR-0012 §3). Read on every
/// authenticated request via UserContextGuard -> auth.api.getSession(); guest
/// requests never touch this table (ADR-0012 §2).
model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One row per credential/identity linked to a User — email+password today
/// (REQ-005), social providers later (REQ-008). Never logged in plaintext
/// (better-auth hashes with scrypt before this is ever written).
model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

/// Short-lived tokens: email verification, password reset (REQ-005/REQ-010).
model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

/// One row per user with opt-in TOTP 2FA (REQ-007). Owned end-to-end by better-auth's
/// `two-factor` plugin (its canonical shape from `schema.mjs`, unrenamed, so no
/// `schema.twoFactor.fields.*` override is needed): `secret`/`backupCodes` are written
/// by the plugin (the TOTP secret is encrypted at rest by better-auth via the instance
/// `secret`, never returned), `verified` is the "code confirmed?" gate the plugin flips
/// in `verifyTOTP`, and `failedVerificationCount`/`lockedUntil` back the plugin's own
/// sign-in brute-force lockout (`accountLockout` defaults `maxFailedAttempts` 10,
/// `durationSeconds` 900 — read from the installed 1.6.24 dist, not re-pinned here) —
/// deliberately NOT a hand-rolled limiter (ADR-0035: no bespoke machinery where the
/// framework answers). The plugin's own HTTP routes (`/api/auth/two-factor/*`) stay
/// enabled: they already carry session/`sensitiveSessionMiddleware` guards and a
/// per-route rate limit (the plugin's own `rateLimit` array, window 10s / max 3 — read
/// from the installed 1.6.24 dist, not separately tested), so there is nothing for a
/// Nest controller to interpose the way ADR-0024 did for the device plugin's
/// bearer-token route.
model TwoFactor {
  id                     String    @id @default(uuid())
  /// The TOTP secret — ciphertext (better-auth's `symmetricEncrypt`), `returned: false`.
  secret                 String
  /// Encrypted backup codes (`storeBackupCodes: "encrypted"` default).
  backupCodes            String
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "Code confirmed" — better-auth's canonical schema defaults this to `true`
  /// (`@default(true)`); the plugin writes it explicitly: `false` on a fresh
  /// `enableTwoFactor`, `true` on `verifyTOTP` (the DB default only governs rows not
  /// created through the plugin). The user-visible "2FA on" flag is
  /// `User.twoFactorEnabled`, not this field.
  verified               Boolean   @default(true)
  failedVerificationCount Int      @default(0)
  lockedUntil            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([userId])
  @@index([secret])
}

/// One row per registered WebAuthn passkey (REQ-007 passkey half, ticket 14). Owned
/// end-to-end by better-auth's `@better-auth/passkey` plugin (its canonical shape from
/// `src/schema.ts`, unrenamed, so no `schema.passkey.fields.*` override is needed):
/// `credentialID`/`publicKey`/`counter` are the WebAuthn credential the plugin verifies
/// against on sign-in (`verifyAuthenticationResponse` re-reads the stored public key and
/// bumps `counter` — the clone-detection signal), `deviceType`/`backedUp`/`aaguid`/
/// `transports` are the attestation metadata the plugin persists for display/management,
/// and `name` is the optional user label. `deviceType` is a plain `String`, not a Prisma
/// enum — the plugin writes the SimpleWebAuthn `CredentialDeviceType` union
/// (`"singleDevice" | "multiDevice"`) and a version bump adding a value must never fail a
/// CHECK constraint this schema didn't anticipate (same rule as DeviceCode.status).
///
/// Honest boundary (ticket 14, not silently dropped): the plugin implements passkeys as a
/// *passwordless sign-in method* (`POST /passkey/verify-authentication` mints a session),
/// NOT as a second factor inside better-auth's `two-factor` challenge flow — `twoFactorMethods`
/// only ever contains `totp`/`otp`. And `deletePasskey` is session- and ownership-gated but
/// does NOT require a password re-authentication the way TOTP's `disable` does (the plugin's
/// route uses `sessionMiddleware`, not `sensitiveSessionMiddleware`). Both are documented in
/// REQ-007's register row, not papered over with bespoke interposition (ADR-0035: no Eigenbau).
model Passkey {
  id           String   @id @default(uuid())
  /// Optional user-facing label; empty until the user names the credential.
  name         String?
  /// The credential's public key, base64-encoded (better-auth `base64.encode` of the
  /// COSE public key) — the verification half on sign-in.
  publicKey    String
  /// Scoping key — same trusted userId as every other model (ADR-0007). Never read from
  /// the request body/path.
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// WebAuthn credential ID (the raw ID bytes, base64url-encoded in responses) — the
  /// lookup key the plugin uses to find the stored credential on sign-in.
  credentialID String
  /// Signature counter from the last successful authentication — clone detection.
  counter      Int
  /// "singleDevice" | "multiDevice" (SimpleWebAuthn CredentialDeviceType) — plain string,
  /// see the model comment for why not an enum.
  deviceType   String
  /// Whether the credential is synced/backed up to the platform's cloud.
  backedUp     Boolean
  /// Comma-joined transport hints (e.g. "internal,hybrid") — display/allowCredentials only.
  transports   String?
  /// The authenticator model's AAGUID (attestation metadata); all-zero/absent for
  /// privacy-preserving platforms under `attestation: "none"`.
  aaguid       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([credentialID])
}

/// One row per (userId, steuerjahr) — the raw inputs behind the Cockpit's refund
/// estimate range (REQ-001, steuereule#91/#92). Deliberately stores only the plain
/// facts (`baseEstimate`/`openItems`/`openConflicts`); the derived range itself is
/// never persisted — it's recomputed on every read via @steuereule/core's
/// `cockpitRange()` (ADR-014/048 determinism boundary), so this table can never drift
/// out of sync with the uncertainty rule. No `/// @encrypted` field here: ruled
/// out-of-scope for ADR-0008 in review (Musti) — unlike Profile.steuerId this holds no
/// tax identifier, only a rounded refund estimate and two open-item/conflict counts.
/// Revisit if assessed amounts or income figures ever land on this entity.
model TaxYear {
  id            String   @id @default(uuid())
  /// Scoping key — same trusted userId as Profile.userId (ADR-0007). Never read from
  /// the request path/query/body.
  userId        String
  /// The tax year shown in the Cockpit (e.g. 2026). Part of the request path, but the
  /// row lookup is always userId-scoped first (`@@unique([userId, steuerjahr])`).
  steuerjahr    Int
  /// Base estimate before the range is spread, in whole euro (>= 0). VESTIGIAL as of
  /// ticket 15 (Cockpit-Echtdaten): the Cockpit no longer reads this column — the spanne is
  /// now derived from @steuereule/core's `berechne`+`cockpitSpanne` over the real LStB/interview
  /// figures. Kept as a required column (no default) only so the existing write path
  /// (interview-answer.repository.prisma.ts) can keep seeding an honest `0`; a follow-up
  /// migration may drop it once every writer stops needing it.
  baseEstimate  Int
  /// Number of still-open interview/receipt items (>= 0).
  openItems     Int
  /// Number of open posten conflicts (ADR-008 "± offen"); defaults to 0 until that
  /// feature exists.
  openConflicts Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, steuerjahr])
}

/// One row per (userId, steuerjahr, questionId) — the on-demand catalogue's stored answers
/// (#318 REQ-015's Minimal-Gate; #321's Segment 2 entry — #321 has no REQ id of its own yet,
/// that is Suhay's to create once its ticket is refined, ADR-0025; cite `#321` alone until then,
/// review F7). Additive: the Cockpit read path (REQ-001, Done) is untouched by this model. A gate
/// the user has seen and carried on past is stored here too, under its own gate id, with the
/// fixed value `GATE_ACKNOWLEDGED` (ADR-0033 §"Gates are answerable steps") — no separate model
/// for gates. One shared row set across every catalogue entry for the same (userId, steuerjahr) —
/// a catalogue entry is a named set of question ids over this same table, not a second model
/// (ADR-0031 §3); `packages/core/src/interview.ts`'s `entryForStep` derives which entry a given
/// row's `questionId` belongs to. Segment 2's rows are DECLARED here (this model admits any
/// `questionId` string) but nothing writes them yet — the only write path today is bound to
/// `ENTRIES['minimal-gate']`, so no Segment-2 row can exist in a real database until R2 (#321)
/// admits Segment-2 questionIds server-side. Do not read this model as though Segment-2 answers
/// are already live.
model InterviewAnswer {
  id         String   @id @default(uuid())
  /// Scoping key — same trusted userId as Profile.userId (ADR-0007). Never read from
  /// the request path/query/body.
  userId     String
  /// The tax year this answer belongs to — answers are collected per Steuerjahr, same
  /// granularity as TaxYear.
  steuerjahr Int
  /// An `EntryStepId` from packages/core/src/interview.ts's `QUESTIONS` registry — the current,
  /// exhaustive set (not hand-copied here, so this comment cannot drift the way ADR-0033
  /// already names as a real defect class for this file). Left in the clear (unlike `value`
  /// below) so uniqueness, lookup and remainingSteps()/isReachable()'s replay over stored
  /// answers keep working without decrypting anything.
  //
  // CAUTION (found the hard way, `//` not `///` deliberately — see below): prisma-field-
  // encryption matches a literal substring anywhere in a field's *own* `///` doc
  // comment (dmmf.js's encryptedAnnotationRegex — an "@" immediately followed by that
  // word, no negation-aware parsing). An earlier draft's doc comment for this field
  // *described* that other annotation in prose to explain why this field carries no
  // such annotation, and the description alone was enough to trip it — this plaintext
  // field silently got encrypted too. Never let that word (with its "@" prefix) appear
  // inside a `///` block for a field that must stay unencrypted; this note is `//` (a
  // plain comment, invisible to Prisma's DMMF and therefore to that regex) precisely
  // so explaining the trap can never re-trigger it.
  questionId String
  /// The stored answer value — one of that question's accepted values, or
  /// `GATE_ACKNOWLEDGED` for a gate row. Field-encrypted at rest from day one
  /// (ADR-0008 ruling in #318): unlike TaxYear this holds personal facts about the
  /// user (employment status, foreign work, children) that are joinable to Profile's
  /// Steuer-ID via the same userId. `mode=strict` — see Profile.steuerId's comment
  /// for why a tampered/corrupted ciphertext must throw on read, never pass through.
  value      String   /// @encrypted?mode=strict
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, steuerjahr, questionId])
  @@index([userId, steuerjahr])
}

/// QR-code device-authorization (#238, RFC 8628, ADR-0024). better-auth's
/// `device-authorization` plugin owns this table's core nine fields — its own
/// canonical shape (`schema.mjs`), unrenamed, so no `schema.deviceCode.fields.*`
/// override is needed on the plugin config side. The plugin's own HTTP routes are
/// switched off via `disabledPaths` (ADR-0024) — only our `/v1/device/*` endpoints
/// and server-side `auth.api.*` calls ever touch this table, which is what makes the
/// four `request*` columns below safe to add: the plugin never reads or writes
/// them, so there is nothing for it to conflict with.
model DeviceCode {
  id              String    @id @default(uuid())
  /// RFC 8628 `device_code` — the polling secret, never shown to a human.
  deviceCode      String    @unique
  /// RFC 8628 `user_code` — the short code shown on the desktop and typed/matched on
  /// the phone. Looked up directly by the plugin's `/device`, `/device/approve`,
  /// `/device/deny` handlers.
  userCode        String    @unique
  /// Claimed by `/device` (GET) once a signed-in phone opens the verification URL —
  /// null while pending-unclaimed. Never the desktop's identity; always the
  /// approving phone's.
  userId          String?
  expiresAt       DateTime
  /// One of "pending" | "approved" | "denied" — a plain plugin-owned string, not a
  /// Prisma enum, so a plugin version bump introducing a new status value can never
  /// fail a CHECK constraint this schema didn't anticipate.
  status          String
  /// Set on each `/device/token` poll — backs the plugin's own `slow_down` throttle.
  lastPolledAt    DateTime?
  /// Milliseconds between polls (plugin's `interval` option, ms-encoded).
  pollingInterval Int?
  clientId        String?
  /// Space-separated OAuth-style scope string (plugin's own RFC 8628 field).
  scope           String?

  // --- Our columns (ADR-0024) — nullable, additive, never read by the plugin ---
  /// The desktop's User-Agent at `/v1/device/code` request time — match-verification
  /// evidence (AC-3) for the phone's approval screen, never the approving phone's own.
  requestUserAgent String?
  /// The desktop's request IP at `/v1/device/code` time — the geo-IP resolver's
  /// input (task 0b); never persisted alongside a resolved region that could outlive
  /// its own accuracy guarantee (the resolver re-derives `requestRegion` once, at
  /// write time, from this same value).
  requestIp        String?
  /// Country-level result of resolving `requestIp` (task 0b) — `null` until
  /// resolved, "unknown" (never a guess) when the address is private/unroutable or
  /// the geo-IP database is stale (ADR-0021 control). Two consumers: the phone's
  /// match-verification approval screen and the device list in Profil.
  requestRegion    String?
  /// When the desktop's `/v1/device/code` request was made — distinct from
  /// `expiresAt`/`lastPolledAt`, which are the plugin's own protocol timestamps.
  requestedAt      DateTime?

  @@index([userId])
}

/// Minimal Löschschutz seam (ADR-0013 §5, product ADR-011). While a hold is active
/// (`holdUntil` in the future) for a given userId/resource pair, the account-deletion
/// transaction exempts that resource from erasure/anonymisation instead of tearing it
/// down. `resource` names the thing held — today only "profile" and "auditLog" are
/// meaningful (no filing/tax-year Löschschutz model persists yet), so the exempt set
/// is vacuous in real use; the REQ-011 acceptance test seeds a synthetic row to
/// exercise both the exempt and non-exempt branches for real. Expand-only: this
/// migration adds only this one new table, no change to any existing model.
model LegalHold {
  id        String   @id @default(uuid())
  /// Scoping key — same trusted userId namespace as Profile/TaxDataAccessLog.
  userId    String
  /// The resource held, e.g. "profile" or "auditLog" — matches the model the
  /// deletion transaction consults it against, never a free-text label.
  resource  String
  /// The hold is active while `holdUntil` is in the future; once past, the deletion
  /// transaction treats it as expired and proceeds normally.
  holdUntil DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// One row per uploaded receipt (ADR-007/008). Lands UNBOUND (no year): the user
/// photographs a receipt at the moment of receipt, not while filing. The extraction
/// SUGGESTS a Steuerjahr — payment date over invoice date (§ 11 EStG Zufluss/Abfluss:
/// the payment date fixes the year, not the invoice date) — and a tap confirms.
/// Assigning a year that contradicts the date-derived suggestion yields a visible
/// KONFLIKT state, never a silent overwrite (ADR-008). Scan/OCR is out of scope here
/// (ADR-036/045, later slices) — this model stores the DATA interface only: dates,
/// filename, confirmed year. The Zuordnung STATE is deliberately not a column: it is
/// derived on every read from (steuerjahr, belegdatum, zahlungsdatum) via
/// @steuereule/core's `zuordnungAusDaten` (ADR-014/048 determinism boundary — a stored
/// copy of a derivable state could only drift). `dateiname` is field-encrypted at rest
/// (ADR-0008): filenames can carry PII, and the column is joinable to Profile's
/// Steuer-ID via the same userId. The dates stay in the clear — the suggestion rule and
/// the (userId, steuerjahr) index need them without decrypting, and a date alone is not
/// a tax identifier (the ADR-0008 ruling that put InterviewAnswer.value in the clear was
/// about uniqueness/lookup; here it is about the derived-state rule, same instinct).
model Beleg {
  id            String    @id @default(uuid())
  /// Scoping key — same trusted userId as Profile.userId (ADR-0007). Never read from the
  /// request path/query/body.
  userId        String
  /// Original filename/storage key. Encrypted at rest (ADR-0008).
  dateiname     String    /// @encrypted?mode=strict
  /// Document type (ADR-029): one of belegart.ts's `Belegart` values (Lohnausweis,
  /// Quellensteuer, Pensionskasse, Saeule3a, Krankenkasse, Familienzulage, Sonstiges) —
  /// null is the pre-CH undifferentiated receipt (not yet classified); 'Sonstiges' is an
  /// explicitly chosen generic receipt. A plain discriminator, not a tax fact: left in the
  /// clear (no field-level protection, same reasoning as the dates) so the inbox can group
  /// by it without decrypting.
  art           String?
  /// Invoice date (Rechnungsdatum). Clear — the suggestion rule reads it without decrypting.
  belegdatum    DateTime?
  /// Payment date (Zahlungsdatum) — § 11 Zufluss fixes the year, not the invoice date.
  zahlungsdatum DateTime?
  /// The CONFIRMED year (a tap has happened). Null while unbound/suggested. The
  /// suggestion itself is derived, never stored.
  steuerjahr    Int?
  /// ADR-008 "bei meinem Jahr bleiben": whether the user explicitly dismissed the
  /// date-derived suggestion to keep their own confirmed year — a persisted FACT (not the
  /// derived state), so `zuordnungAusDaten` can resolve the conflict without silently
  /// overwriting the contradicting dates.
  vorschlagVerworfen Boolean  @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([userId, steuerjahr])
}

/// One row per (userId, steuerjahr) — the LStB (Lohnsteuerbescheinigung) guided-mask data for the
/// Angestellte-Vertikale (ticket 08, ADR-036 Scan-Fallback). The user transcribes the three printed
/// figures (Bruttoarbeitslohn, einbehaltene Lohnsteuer, SV-Arbeitnehmeranteil) field by field; the
/// photo stays stored as a Beleg (ADR-007), and Scan/OCR is a later slice (ADR-045). Each field's
/// stored string encodes its honest state (packages/core/src/lstb.ts is the ONE place that maps):
/// `null` = `offen` (not reached yet), the reserved marker `unklar` = "looked but could not read",
/// any other string = a whole-euro amount (`erfasst`). The derived `LstbZustand`
/// (unvollstaendig / widerspruch / vollstaendig) is recomputed on every read via @steuereule/core's
/// `lstbZustand`, never stored (ADR-014/048 determinism boundary). The figures are field-encrypted
/// at rest (ADR-0008): actual income is the most sensitive personal fact a tax app holds, joinable
/// to Profile's Steuer-ID via the same userId — unlike TaxYear (counts only) or the Beleg dates
/// (needed clear for the suggestion rule).
model Lstb {
  id                 String   @id @default(uuid())
  /// Scoping key — same trusted userId as Profile.userId (ADR-0007). Never read from the
  /// request path/query/body.
  userId             String
  /// The tax year these figures belong to (same granularity as TaxYear/InterviewAnswer).
  steuerjahr         Int
  /// Bruttoarbeitslohn (Zeile 3). Encrypted at rest (ADR-0008); null=offen, "unklar"=unreadable.
  bruttoarbeitslohn  String?  /// @encrypted?mode=strict
  /// Einbehaltene Lohnsteuer (Zeile 4). Encrypted at rest; same state encoding.
  lohnsteuer         String?  /// @encrypted?mode=strict
  /// Arbeitnehmer-Anteil der SV-Beiträge (Zeilen 22/23). Encrypted at rest; same state encoding.
  sozialversicherung String?  /// @encrypted?mode=strict
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, steuerjahr])
}

/// One row per (userId, steuerjahr) — the CH-Lohnausweis guided-mask data (ADR-036 Scan-Fallback,
/// Grenzgänger-CH vertical, ticket 16). The user transcribes the 15 printed Ziffern (Formular 11,
/// ESTV) field by field in paper order; the photo stays stored as a Beleg (ADR-007), and Scan/OCR is
/// a later slice (ADR-045). Each CHF field's stored string encodes its honest state
/// (packages/core/src/grenzgaenger.ts is the ONE place that maps): `null` = `offen` (not reached
/// yet), the reserved marker `unklar` = "looked but could not read", any other string = a whole-CHF
/// amount (`erfasst`). `bemerkungen` (Ziffer 15) is Freitext and stores its text directly. The
/// figures are field-encrypted at rest (ADR-0008): actual income is the most sensitive personal
/// fact a tax app holds, joinable to Profile's Steuer-ID via the same userId. The Wechselkurs
/// (ADR-012) and the optional Säule 3a / Krankenkasse amounts (ADR-029 points 4–5) live on the same
/// row — the fold (grenzgaengerStand) reads them all, so a partial re-read resumes without losing
/// the Kurs the CHF→EUR conversion was made with. The Wechselkurs columns stay in the clear: the
/// BMF rate is public and the fold needs them without decrypting.
model ChLohnausweis {
  id                        String   @id @default(uuid())
  /// Scoping key — same trusted userId as Profile.userId (ADR-0007). Never read from the
  /// request path/query/body.
  userId                    String
  /// The tax year these figures belong to (same granularity as TaxYear/Lstb).
  steuerjahr                Int
  /// Ziffer 1 — Lohn (Grundlohn). Encrypted at rest; null=offen, "unklar"=unreadable.
  lohn                      String? /// @encrypted?mode=strict
  /// Ziffer 2 — Gehaltsnebenleistungen. Encrypted at rest.
  gehaltsnebenleistungen    String? /// @encrypted?mode=strict
  /// Ziffer 3 — Unregelmäßige Leistungen. Encrypted at rest.
  unregelmaessigeLeistungen String? /// @encrypted?mode=strict
  /// Ziffer 4 — Kapitalleistungen. Encrypted at rest.
  kapitalleistungen         String? /// @encrypted?mode=strict
  /// Ziffer 5 — Beteiligungsrechte. Encrypted at rest.
  beteiligungsrechte        String? /// @encrypted?mode=strict
  /// Ziffer 6 — Sitzungsgelder. Encrypted at rest.
  sitzungsgelder            String? /// @encrypted?mode=strict
  /// Ziffer 7 — Andere Leistungen. Encrypted at rest.
  andereLeistungen          String? /// @encrypted?mode=strict
  /// Ziffer 8 — Total Bruttolohn (postenRelevant: Einkünfte). Encrypted at rest.
  bruttolohnTotal           String? /// @encrypted?mode=strict
  /// Ziffer 9 — AHV/IV/EO/ALV/NBUV (1. Säule). Encrypted at rest.
  ahvBeitraege              String? /// @encrypted?mode=strict
  /// Ziffer 10 — berufliche Vorsorge (2. Säule / PK, postenRelevant: Vorsorgeaufwand). Encrypted.
  beruflicheVorsorge        String? /// @encrypted?mode=strict
  /// Ziffer 11 — Nettolohn. Encrypted at rest.
  nettolohn                 String? /// @encrypted?mode=strict
  /// Ziffer 12 — Quellensteuerabzug (postenRelevant: Anrechnung). Encrypted at rest.
  quellensteuer             String? /// @encrypted?mode=strict
  /// Ziffer 13 — Spesen. Encrypted at rest.
  spesen                    String? /// @encrypted?mode=strict
  /// Ziffer 14 — Weitere Nebenleistungen. Encrypted at rest.
  weitereNebenleistungen    String? /// @encrypted?mode=strict
  /// Ziffer 15 — Bemerkungen (Freitext). Encrypted at rest (free text can carry PII).
  bemerkungen               String? /// @encrypted?mode=strict
  /// Säule 3a (ADR-029 point 4) — optional whole-CHF amount, null = not entered. Encrypted.
  saeule3aChf               String? /// @encrypted?mode=strict
  /// CH-Krankenkasse (ADR-029 point 5) — optional whole-CHF amount, null = not entered. Encrypted.
  krankenkasseChf           String? /// @encrypted?mode=strict
  /// Wechselkurs-Monat (yyyy-mm) the CHF→EUR conversion applies to (ADR-012).
  wechselkursMonat          String?
  /// Wechselkurs-Kurs (EUR per 1 CHF, strictly positive) — public BMF rate, clear.
  wechselkursKurs           Float?
  /// Wechselkurs-Modus (amtlich | tatsaechlich). Clear.
  wechselkursModus          String?
  /// Beleg id for a tatsächlicher Kurs (ADR-012: "ohne Beleg kein tatsächlicher Kurs"). Clear.
  wechselkursBelegId        String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@unique([userId, steuerjahr])
}

/// One row per (userId, steuerjahr) — the Rentner guided-mask data (product ADR-034, Anlage R,
/// ticket 10.4). The user transcribes their Rentenbezugsmitteilung: the Rentenart (product ADR-036
/// §3 — one of the five 1.0 kinds), the Jahresbetrag, and either the Rentenbeginn-Jahr
/// (Besteuerungsanteil path) or the Rentenbeginn-Lebensalter (Ertragsanteil path for the private
/// Rentenversicherung). Scan/OCR is a later slice (ADR-045). Each field's stored string encodes its
/// honest state (packages/core/src/rente.ts is the ONE place that maps): `null` = `offen` (not
/// reached yet), the reserved marker `unklar` = "looked but could not read", any other string = a
/// non-negative integer (`erfasst`). The taxable share (Jahresbetrag × Besteuerungs-/Ertragsanteil)
/// is recomputed on every read via @steuereule/core's `renteAlsKernposten`, never stored
/// (ADR-014/048 determinism boundary). `rentenart` is a plain discriminator (null = not yet chosen),
/// left in the clear like Beleg.art — the five values are not joinable PII and the screen needs them
/// to render the picker without decrypting. The three figures are field-encrypted at rest (ADR-0008):
/// actual income is the most sensitive personal fact a tax app holds, and the Rentenbeginn-Jahr /
/// -Lebensalter are personal facts that fix the tax treatment, joinable to Profile's Steuer-ID via
/// the same userId.
model Rente {
  id                   String   @id @default(uuid())
  /// Scoping key — same trusted userId as Profile.userId (ADR-0007). Never read from the
  /// request path/query/body.
  userId               String
  /// The tax year these figures belong to (same granularity as TaxYear/Lstb/ChLohnausweis).
  steuerjahr           Int
  /// One of rente.ts's five `Rentenart` values, null = not yet chosen. Clear (plain discriminator).
  rentenart            String?
  /// Jahresbetrag der Rente (whole euros). Encrypted at rest; null=offen, "unklar"=unreadable.
  jahresbetrag         String? /// @encrypted?mode=strict
  /// Jahr des Rentenbeginns — fixes the Besteuerungsanteil (aa). Encrypted at rest; same encoding.
  rentenbeginnJahr     String? /// @encrypted?mode=strict
  /// Vollendetes Lebensjahr bei Rentenbeginn — fixes the Ertragsanteil (bb). Encrypted at rest.
  alterBeiRentenbeginn String? /// @encrypted?mode=strict
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId, steuerjahr])
}

/// One row per (userId, steuerjahr) — the Steuerbescheid (Bescheidprüfung 1.0, ticket 10.3,
/// ADR-009). The Bescheid arrives as a Beleg (art `Steuerbescheid`) and its five figures are
/// transcribed field by field (guided mask, ADR-036 — Scan/OCR is OUT of scope, ADR-045); the
/// photo/PDF stays stored as the Beleg. Each figure's stored string encodes its honest state
/// (packages/core/src/bescheid.ts is the ONE place that maps): `null` = `offen` (not reached yet),
/// the reserved marker `unklar` = "looked but could not read", any other string = a whole-euro
/// amount (`erfasst`; `erstattung` is the one signed field — Nachzahlung < 0). The figures are
/// field-encrypted at rest (ADR-0008): actual income/tax figures are the most sensitive personal
/// facts a tax app holds, joinable to Profile's Steuer-ID via the same userId. The phase sub-state
/// (`status`) and the Bescheiddatum stay in the clear: the server-side transition validation and
/// the § 355 AO Fristen-Countdown need them without decrypting, and neither is a tax identifier.
model Bescheid {
  id                  String   @id @default(uuid())
  /// Scoping key — same trusted userId as Profile.userId (ADR-0007). Never read from the
  /// request path/query/body.
  userId              String
  /// The tax year these figures belong to (same granularity as Lstb/ChLohnausweis).
  steuerjahr          Int
  /// The bescheid-phase sub-state (eingegangen | geprüft | einspruch-eingelegt), validated on
  /// every write against @steuereule/core's istBescheidUebergangErlaubt — kein stiller Übergang.
  status              String   @default("eingegangen")
  /// Bescheiddatum (ISO yyyy-mm-dd) — the § 355 AO Einspruchsfrist runs from here. Clear.
  bescheiddatum       String?
  /// Einspruch-Grund (closed set from @steuereule/core's EINSPRUCHS_GRUENDE), null until filed.
  einspruchGrund      String?
  /// Einkünfte laut Bescheid (comparable). Encrypted at rest; null=offen, "unklar"=unreadable.
  einnahmen           String?  /// @encrypted?mode=strict
  /// Vorsorgeaufwendungen laut Bescheid (comparable). Encrypted at rest.
  vorsorgeaufwand     String?  /// @encrypted?mode=strict
  /// Anrechenbare Steuern (Quellensteuer) laut Bescheid (comparable). Encrypted at rest.
  anrechnung          String?  /// @encrypted?mode=strict
  /// Festgesetzte Einkommensteuer (Bescheid-only, not comparable). Encrypted at rest.
  festgesetzteSteuer  String?  /// @encrypted?mode=strict
  /// Abschlusszahlung: Erstattung > 0, Nachzahlung < 0 (Bescheid-only, not comparable). Encrypted.
  erstattung          String?  /// @encrypted?mode=strict
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userId, steuerjahr])
  @@index([userId])
}

// Prisma schema for the Onboarding Profile (steuereule#29).
// Managed EU Postgres, expand-only versioned migrations (ADR-047).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One row per userId (guest session or real account, ADR-0007). Plain persisted
/// facts collected during Onboarding — no derived values, clean side of the
/// determinism boundary (ADR-014/048); @steuereule/core never recomputes these.
model Profile {
  id           String   @id @default(uuid())
  /// Scoping key. Never read from the request body/query/path — only ever set
  /// from the trusted userId the UserContextGuard produced (ADR-0007).
  userId       String   @unique
  firstName    String
  lastName     String
  /// Steuerliche Identifikationsnummer — exactly 11 digits (validated server-side
  /// via @steuereule/core's isValidSteuerId before this is ever written).
  /// Field-encrypted at rest (ADR-0008, prisma-field-encryption, AES-256-GCM,
  /// randomized nonce per write — ciphertext is longer than the plaintext digit
  /// string, so the column stays `String`, no type migration needed). `mode=strict`
  /// so a tampered/corrupted ciphertext throws on read instead of silently passing
  /// through as clear text or null (REQ-003.5) — safe once every existing row is
  /// encrypted, which is true from this migration onward.
  steuerId     String /// @encrypted?mode=strict
  /// Optional — 1-13 digits if present (isValidSteuernummer). Field-encrypted at
  /// rest for the same reason as steuerId.
  steuernummer String? /// @encrypted?mode=strict
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Append-only audit trail of who touched a user's sensitive tax/profile fields, and
/// when (ADR-0008, REQ-004, DSGVO Art. 30 accountability). Deliberately carries no
/// value column — not the plaintext, not the ciphertext — only who/what/when. Never
/// updated or deleted at the application layer (no repository method exposes
/// anything but append); DB-level (role/trigger) enforcement is a follow-up.
model TaxDataAccessLog {
  id        String      @id @default(uuid())
  /// Scoping key — same trusted userId as Profile.userId (ADR-0007). Never joined
  /// across users; every read of this table is scoped to a single userId.
  userId    String
  action    AuditAction
  /// The resource/field-class touched, e.g. "profile". A short discriminator, never
  /// the sensitive value itself.
  resource  String
  createdAt DateTime    @default(now())

  @@index([userId])
}

enum AuditAction {
  READ
  WRITE
}

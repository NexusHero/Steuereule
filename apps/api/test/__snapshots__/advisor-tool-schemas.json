  {
    "type": "function",
    "function": {
      "name": "ask_questions",
      "description": "Stellt dem Nutzer eine Runde von 1 bis 4 Fragen, jede mit 2 bis 4 antippbaren Antworten. `kind`: `fact` für Tatsachen (was er hatte oder tat), dann KEINE Empfehlung; `decision` für eine Entscheidung (z. B. Veranlagungsart), dann `recommended` (eine der Antworten) und `reason` (ein kurzer Satz, warum). `multiple: true`, wenn mehrere Antworten zutreffen können („Was davon hattest du?“, mit einer Antwort wie „Nichts davon“). Nur im Skill „Berater-Interview“ und in der Eröffnung eines Gesprächs verwenden. Schreibt nichts in die Akte.",
      "parameters": {
        "type": "object",
        "properties": {
          "questions": {
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "options": {
                  "minItems": 2,
                  "maxItems": 4,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "kind": {
                  "default": "fact",
                  "type": "string",
                  "enum": [
                    "fact",
                    "decision"
                  ]
                },
                "multiple": {
                  "default": false,
                  "type": "boolean"
                },
                "recommended": {
                  "type": "string",
                  "maxLength": 80
                },
                "reason": {
                  "type": "string",
                  "maxLength": 160
                }
              },
              "required": [
                "text",
                "options",
                "kind",
                "multiple"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "questions"
        ],
        "additionalProperties": false
      }
    }
  },

# Copy to .env for local dev. Never commit real secrets (12-Factor III).

# Managed EU Postgres (ADR-047).
DATABASE_URL="postgresql://user:password@localhost:5432/steuereule?schema=public"

# Signs the guest-session cookie (ADR-0007 phase 1 seam). Falls back to a fixed
# dev-only secret outside production; MUST be set to a real random value in prod.
GUEST_SESSION_SECRET="change-me-to-a-long-random-value"

# Field-encryption key for sensitive Profile fields (Steuer-ID/Steuernummer, ADR-0008).
# Sealed secret today, KMS later — see resolveFieldEncryptionKey(). Falls back to a
# fixed dev-only key outside production; MUST be set to a real generated key in prod
# (`npx cloak generate`, format `k1.aesgcm256.<base64 32 bytes>`). Never commit a real key.
PRISMA_FIELD_ENCRYPTION_KEY="k1.aesgcm256.change-me-to-a-generated-key="
# Comma-separated retired keys still needed to decrypt old rows during rotation.
# PRISMA_FIELD_DECRYPTION_KEYS=""

PORT=3000

# Credentialed cross-origin CORS (ADR-0011). Comma-separated exact-match allowlist of web
# origins allowed to call this API with cookies (never `*`); unset/empty grants nothing
# (fail-closed). Set to the local Expo web dev origin for local dev, and the deployed web
# origin for the live demo/prod.
CORS_ALLOWED_ORIGINS="http://localhost:8081"

# Trusted reverse-proxy hops (#241) — which addresses better-auth should strip from a
# forwarded IP chain (X-Forwarded-For) before trusting what's left. Governs
# Session.ipAddress and better-auth's own built-in rate limiter (REQ-010/ADR-0013 §6).
# Comma-separated IP/CIDR entries, or the literal "none" to record "no proxy in front
# of this deployment" as a deliberate choice. Falls back to unconfigured (today's
# actual posture) outside production; MUST be set explicitly in prod — to a real value
# or to "none" — or the API refuses to boot (#241; the real deployment CIDR ranges
# depend on #246 and are not yet known).
# TRUSTED_PROXIES="none"

# The web app's own origin (#238, ADR-0024) — used to build the device-authorization
# QR's verification URL so it points at a route the frontend router owns instead of
# this API's own origin. Deliberately its own variable, not derived from
# CORS_ALLOWED_ORIGINS above (that's an allowlist, with no "canonical first entry").
# Falls back to the local Expo web dev origin outside production; MUST be set to the
# deployed web origin in prod.
WEB_APP_URL="http://localhost:8081"

# Google OAuth (REQ-008). Create credentials at console.cloud.google.com → APIs & Services →
# Credentials → OAuth 2.0 Client ID. Set the redirect URI to <BETTER_AUTH_URL>/api/auth/callback/google.
# Falls back to dev-only placeholders outside production; MUST be set in prod.
# GOOGLE_CLIENT_ID="your-real-google-client-id"
# GOOGLE_CLIENT_SECRET="your-real-google-client-secret"

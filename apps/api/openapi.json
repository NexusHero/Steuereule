{
  "openapi": "3.0.0",
  "paths": {
    "/v1/auth/capabilities": {
      "get": {
        "operationId": "AuthCapabilitiesController_getCapabilities",
        "parameters": [],
        "responses": {
          "200": {
            "description": "What this deployment can authenticate with. `socialProviders` is empty when none are configured; clients must then not offer social sign-in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthCapabilitiesDto"
                }
              }
            }
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/profile": {
      "get": {
        "operationId": "ProfileController_getProfile",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The caller’s saved profile, or an all-null default if none was saved yet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "profile"
        ]
      },
      "put": {
        "operationId": "ProfileController_putProfile",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutProfileDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The saved profile, echoed back.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Payload failed server-side validation; nothing was persisted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorDto"
                }
              }
            }
          }
        },
        "tags": [
          "profile"
        ]
      }
    },
    "/v1/steuerjahre/{jahr}/cockpit": {
      "get": {
        "operationId": "CockpitController_getCockpitSummary",
        "parameters": [
          {
            "name": "jahr",
            "required": true,
            "in": "path",
            "description": "The tax year (Steuerjahr) to summarize — validated to a sensible window (2000..currentYear+1), never just \"parses as a number\".",
            "schema": {
              "example": 2026,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The caller’s Cockpit summary for the given tax year, or null when nothing has been seeded/entered yet for it (the honest empty state, not a 404).",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/CockpitSummaryDto"
                    }
                  ],
                  "nullable": true
                }
              }
            }
          }
        },
        "tags": [
          "cockpit"
        ]
      }
    },
    "/v1/account": {
      "delete": {
        "operationId": "AccountDeletionController_deleteAccount",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteAccountRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The account was torn down (ADR-0013). An honest summary of what was erased, anonymised-and-retained, or held under active Löschschutz.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteAccountResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "`confirm` was not exactly `true`, or the session is not fresh enough and no `password` was given (re-verification required)."
          },
          "401": {
            "description": "The given `password` failed re-verification."
          },
          "403": {
            "description": "A guest session — there is no real account here to delete."
          },
          "429": {
            "description": "Too many password re-verification attempts; the existing DB-backed rate limit tripped (ADR-0013 §6)."
          }
        },
        "tags": [
          "account"
        ]
      }
    },
    "/v1/account/export": {
      "get": {
        "operationId": "AccountExportController_exportAccount",
        "parameters": [
          {
            "name": "format",
            "required": false,
            "in": "query",
            "description": "json (default) or pdf.",
            "schema": {
              "enum": [
                "json",
                "pdf"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The caller’s full DSGVO export (Art. 15/20), assembled once and returned either as this JSON document (?format=json, the default) or as an equivalent German PDF-Bericht (?format=pdf, application/pdf, same fields, human-readable). Both branches append exactly one READ/export audit entry before the response is sent (ADR-0013).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportDocumentDto"
                }
              },
              "application/pdf": {
                "schema": {
                  "$ref": "#/components/schemas/ExportDocumentDto"
                }
              }
            }
          },
          "404": {
            "description": "The caller has no better-auth account yet (a guest that never signed up)."
          }
        },
        "tags": [
          "account"
        ]
      }
    }
  },
  "info": {
    "title": "SteuerEule API",
    "description": "Onboarding profile endpoints (steuereule#29)",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "AuthCapabilitiesDto": {
        "type": "object",
        "properties": {
          "socialProviders": {
            "description": "Social providers this deployment will actually accept, e.g. [\"google\"]. Empty when none are configured — the client must then not offer social sign-in at all, rather than offering a button that always errors.",
            "example": [
              "google"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "socialProviders"
        ]
      },
      "ProfileResponseDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "nullable": true,
            "example": "Anna"
          },
          "lastName": {
            "type": "string",
            "nullable": true,
            "example": "Beispiel"
          },
          "steuerId": {
            "type": "string",
            "nullable": true,
            "example": "02476291358"
          },
          "steuernummer": {
            "type": "string",
            "nullable": true,
            "example": "18181508155"
          }
        },
        "required": [
          "firstName",
          "lastName",
          "steuerId",
          "steuernummer"
        ]
      },
      "PutProfileDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "example": "Anna",
            "description": "Non-empty first name."
          },
          "lastName": {
            "type": "string",
            "example": "Beispiel",
            "description": "Non-empty last name."
          },
          "steuerId": {
            "type": "string",
            "example": "02476291358",
            "description": "Steuerliche Identifikationsnummer — exactly 11 digits."
          },
          "steuernummer": {
            "type": "string",
            "example": "18181508155",
            "description": "Steuernummer — optional; 1-13 digits (no separators) if present."
          }
        },
        "required": [
          "firstName",
          "lastName",
          "steuerId"
        ]
      },
      "ValidationFieldErrorDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "steuerId"
          },
          "message": {
            "type": "string",
            "example": "steuerId must be exactly 11 digits"
          }
        },
        "required": [
          "field",
          "message"
        ]
      },
      "ValidationErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "error": {
            "type": "string",
            "example": "Bad Request"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationFieldErrorDto"
            }
          }
        },
        "required": [
          "statusCode",
          "error",
          "fields"
        ]
      },
      "EstimateRangeDto": {
        "type": "object",
        "properties": {
          "from": {
            "type": "number",
            "example": 1227,
            "description": "Lower bound of the estimate range, in whole euro."
          },
          "to": {
            "type": "number",
            "example": 1587,
            "description": "Upper bound of the estimate range, in whole euro."
          }
        },
        "required": [
          "from",
          "to"
        ]
      },
      "CockpitSummaryDto": {
        "type": "object",
        "properties": {
          "taxYear": {
            "type": "number",
            "example": 2026
          },
          "estimate": {
            "$ref": "#/components/schemas/EstimateRangeDto"
          },
          "openItems": {
            "type": "number",
            "example": 3,
            "description": "Count of still-open interview/receipt items."
          }
        },
        "required": [
          "taxYear",
          "estimate",
          "openItems"
        ]
      },
      "DeleteAccountRequestDto": {
        "type": "object",
        "properties": {
          "confirm": {
            "type": "boolean",
            "enum": [
              true
            ],
            "example": true,
            "description": "Explicit confirmation — must be exactly `true`. The mandatory pre-delete export offer and Löschschutz warning are a frontend/UX concern; this is the server-side confirmation gate."
          },
          "password": {
            "type": "string",
            "description": "Required only when the caller’s current session is not fresh enough (ADR-0013 §6) — re-verified via better-auth’s own password check, never a second hand-rolled one."
          }
        },
        "required": [
          "confirm"
        ]
      },
      "DeletedSummaryDto": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "boolean",
            "example": true,
            "description": "False only when an active LegalHold on \"profile\" exempted the row — it still exists, retained under legal obligation."
          },
          "account": {
            "type": "boolean",
            "enum": [
              true
            ],
            "example": true,
            "description": "Always true — the account (User, cascading Session/Account) and its Verification rows are always torn down; LegalHold never exempts login/identity itself."
          }
        },
        "required": [
          "profile",
          "account"
        ]
      },
      "DeleteAccountResponseDto": {
        "type": "object",
        "properties": {
          "deleted": {
            "$ref": "#/components/schemas/DeletedSummaryDto"
          },
          "retainedAnonymisedAuditRows": {
            "type": "number",
            "example": 0,
            "description": "Count of TaxDataAccessLog rows anonymised (userId severed to an irreversible tombstone) by this call — retained as the Art. 30 accountability record, no longer person-linkable."
          },
          "retainedUnderLegalHold": {
            "type": "number",
            "example": 0,
            "description": "Count of rows retained untouched — neither erased nor anonymised — because an active LegalHold exempted them."
          }
        },
        "required": [
          "deleted",
          "retainedAnonymisedAuditRows",
          "retainedUnderLegalHold"
        ]
      },
      "ExportAccountDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "anna@example.com"
          },
          "name": {
            "type": "string",
            "example": "Anna Beispiel"
          },
          "emailVerified": {
            "type": "boolean",
            "example": true
          },
          "createdAt": {
            "type": "string",
            "example": "2026-01-15T09:30:00.000Z"
          },
          "authProviders": {
            "example": [
              "credential"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "email",
          "name",
          "emailVerified",
          "createdAt",
          "authProviders"
        ]
      },
      "ExportProfileDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "example": "Anna"
          },
          "lastName": {
            "type": "string",
            "example": "Beispiel"
          },
          "steuerId": {
            "type": "string",
            "example": "02476291358"
          },
          "steuernummer": {
            "type": "string",
            "nullable": true,
            "example": "18181508155"
          },
          "createdAt": {
            "type": "string",
            "example": "2026-01-15T09:30:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "example": "2026-02-01T09:30:00.000Z"
          }
        },
        "required": [
          "firstName",
          "lastName",
          "steuerId",
          "steuernummer",
          "createdAt",
          "updatedAt"
        ]
      },
      "ExportAccessLogEntryDto": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "example": "READ"
          },
          "resource": {
            "type": "string",
            "example": "export"
          },
          "createdAt": {
            "type": "string",
            "example": "2026-02-01T09:30:00.000Z"
          }
        },
        "required": [
          "action",
          "resource",
          "createdAt"
        ]
      },
      "ExportDocumentDto": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "example": "1.0"
          },
          "exportedAt": {
            "type": "string",
            "example": "2026-02-01T09:30:00.000Z"
          },
          "account": {
            "$ref": "#/components/schemas/ExportAccountDto"
          },
          "profile": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ExportProfileDto"
              }
            ]
          },
          "taxData": {
            "example": [],
            "description": "Always empty until a tax-year model exists.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "accessLog": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExportAccessLogEntryDto"
            }
          }
        },
        "required": [
          "schemaVersion",
          "exportedAt",
          "account",
          "profile",
          "taxData",
          "accessLog"
        ]
      }
    }
  }
}

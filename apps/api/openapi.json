{
  "openapi": "3.0.0",
  "paths": {
    "/v1/auth/capabilities": {
      "get": {
        "operationId": "AuthCapabilitiesController_getCapabilities",
        "parameters": [],
        "responses": {
          "200": {
            "description": "What this deployment can authenticate with. `socialProviders` is empty when none are configured; clients must then not offer social sign-in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthCapabilitiesDto"
                }
              }
            }
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/profile": {
      "get": {
        "operationId": "ProfileController_getProfile",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The caller’s saved profile, or an all-null default if none was saved yet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "profile"
        ]
      },
      "put": {
        "operationId": "ProfileController_putProfile",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutProfileDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The saved profile, echoed back.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Payload failed server-side validation; nothing was persisted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorDto"
                }
              }
            }
          }
        },
        "tags": [
          "profile"
        ]
      }
    },
    "/v1/steuerjahre/{jahr}/cockpit": {
      "get": {
        "operationId": "CockpitController_getCockpitSummary",
        "parameters": [
          {
            "name": "jahr",
            "required": true,
            "in": "path",
            "description": "The tax year (Steuerjahr) to summarize — validated to a sensible window (2000..currentYear+1), never just \"parses as a number\".",
            "schema": {
              "example": 2026,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The caller’s Cockpit summary for the given tax year, or null when nothing has been seeded/entered yet for it (the honest empty state, not a 404).",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/CockpitSummaryDto"
                    }
                  ],
                  "nullable": true
                }
              }
            }
          }
        },
        "tags": [
          "cockpit"
        ]
      }
    },
    "/v1/steuerjahre/{jahr}/interview": {
      "get": {
        "operationId": "InterviewController_getInterview",
        "parameters": [
          {
            "name": "jahr",
            "required": true,
            "in": "path",
            "description": "The tax year (Steuerjahr) — validated to a sensible window (ParseSteuerjahrPipe, same as Cockpit).",
            "schema": {
              "example": 2026,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The caller’s Minimal-Gate state for this tax year — re-entry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InterviewStateDto"
                }
              }
            }
          },
          "401": {
            "description": "Guest session — this endpoint requires a signed-in account."
          }
        },
        "tags": [
          "interview"
        ]
      }
    },
    "/v1/steuerjahre/{jahr}/interview/antworten": {
      "post": {
        "operationId": "InterviewController_postAnswer",
        "parameters": [
          {
            "name": "jahr",
            "required": true,
            "in": "path",
            "description": "The tax year (Steuerjahr) — validated to a sensible window (ParseSteuerjahrPipe, same as Cockpit).",
            "schema": {
              "example": 2026,
              "type": "number"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostAnswerDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The next step and open-items count after this write.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostAnswerResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "value is not an accepted answer for questionId — nothing was persisted."
          },
          "401": {
            "description": "Guest session — this endpoint requires a signed-in account."
          },
          "409": {
            "description": "questionId is not reachable given the answers stored so far — nothing was persisted."
          }
        },
        "tags": [
          "interview"
        ]
      }
    },
    "/v1/account": {
      "delete": {
        "operationId": "AccountDeletionController_deleteAccount",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteAccountRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The account was torn down (ADR-0013). An honest summary of what was erased, anonymised-and-retained, or held under active Löschschutz.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteAccountResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "`confirm` was not exactly `true`, or the session is not fresh enough and no `password` was given (re-verification required)."
          },
          "401": {
            "description": "The given `password` failed re-verification."
          },
          "403": {
            "description": "A guest session — there is no real account here to delete."
          },
          "429": {
            "description": "Too many password re-verification attempts; the existing DB-backed rate limit tripped (ADR-0013 §6)."
          }
        },
        "tags": [
          "account"
        ]
      }
    },
    "/v1/account/export": {
      "get": {
        "operationId": "AccountExportController_exportAccount",
        "parameters": [
          {
            "name": "format",
            "required": false,
            "in": "query",
            "description": "json (default) or pdf.",
            "schema": {
              "enum": [
                "json",
                "pdf"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The caller’s full DSGVO export (Art. 15/20), assembled once and returned either as this JSON document (?format=json, the default) or as an equivalent German PDF-Bericht (?format=pdf, application/pdf, same fields, human-readable). Both branches append exactly one READ/export audit entry before the response is sent (ADR-0013).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportDocumentDto"
                }
              },
              "application/pdf": {
                "schema": {
                  "$ref": "#/components/schemas/ExportDocumentDto"
                }
              }
            }
          },
          "404": {
            "description": "The caller has no better-auth account yet (a guest that never signed up)."
          }
        },
        "tags": [
          "account"
        ]
      }
    },
    "/v1/device/code": {
      "post": {
        "operationId": "DeviceController_requestCode",
        "parameters": [],
        "responses": {
          "201": {
            "description": "A freshly minted device/user code pair, valid for 2 minutes (ADR-0024).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceCodeResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "device"
        ]
      }
    },
    "/v1/device/pending": {
      "get": {
        "operationId": "DeviceController_getPending",
        "parameters": [
          {
            "name": "userCode",
            "required": true,
            "in": "query",
            "schema": {
              "example": "K7QX-9F2M",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The match-verification payload for a pending device-authorization request (ADR-0024).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevicePendingResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "device"
        ]
      }
    },
    "/v1/device/approve": {
      "post": {
        "operationId": "DeviceController_approve",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApproveDeviceRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Approves the device-authorization request (ADR-0024) — one tap, no session-scope choice.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AckResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "device"
        ]
      }
    },
    "/v1/device/token": {
      "post": {
        "operationId": "DeviceController_exchangeToken",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceTokenRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Exchanges an approved device code for a real session, set as an httpOnly cookie (ADR-0008/0012) — never returned in the response body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AckResponseDto"
                }
              }
            }
          }
        },
        "tags": [
          "device"
        ]
      }
    }
  },
  "info": {
    "title": "SteuerEule API",
    "description": "Onboarding profile endpoints (steuereule#29)",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "AuthCapabilitiesDto": {
        "type": "object",
        "properties": {
          "socialProviders": {
            "description": "Social providers this deployment will actually accept, e.g. [\"google\"]. Empty when none are configured — the client must then not offer social sign-in at all, rather than offering a button that always errors.",
            "example": [
              "google"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "socialProviders"
        ]
      },
      "ProfileResponseDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "nullable": true,
            "example": "Anna"
          },
          "lastName": {
            "type": "string",
            "nullable": true,
            "example": "Beispiel"
          },
          "steuerId": {
            "type": "string",
            "nullable": true,
            "example": "02476291358"
          },
          "steuernummer": {
            "type": "string",
            "nullable": true,
            "example": "18181508155"
          }
        },
        "required": [
          "firstName",
          "lastName",
          "steuerId",
          "steuernummer"
        ]
      },
      "PutProfileDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "example": "Anna",
            "description": "Non-empty first name."
          },
          "lastName": {
            "type": "string",
            "example": "Beispiel",
            "description": "Non-empty last name."
          },
          "steuerId": {
            "type": "string",
            "example": "02476291358",
            "description": "Steuerliche Identifikationsnummer — exactly 11 digits."
          },
          "steuernummer": {
            "type": "string",
            "example": "18181508155",
            "description": "Steuernummer — optional; 1-13 digits (no separators) if present."
          }
        },
        "required": [
          "firstName",
          "lastName",
          "steuerId"
        ]
      },
      "ValidationFieldErrorDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "steuerId"
          },
          "message": {
            "type": "string",
            "example": "steuerId must be exactly 11 digits"
          }
        },
        "required": [
          "field",
          "message"
        ]
      },
      "ValidationErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "error": {
            "type": "string",
            "example": "Bad Request"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationFieldErrorDto"
            }
          }
        },
        "required": [
          "statusCode",
          "error",
          "fields"
        ]
      },
      "EstimateRangeDto": {
        "type": "object",
        "properties": {
          "from": {
            "type": "number",
            "example": 1227,
            "description": "Lower bound of the estimate range, in whole euro."
          },
          "to": {
            "type": "number",
            "example": 1587,
            "description": "Upper bound of the estimate range, in whole euro."
          }
        },
        "required": [
          "from",
          "to"
        ]
      },
      "CockpitSummaryDto": {
        "type": "object",
        "properties": {
          "taxYear": {
            "type": "number",
            "example": 2026
          },
          "estimate": {
            "$ref": "#/components/schemas/EstimateRangeDto"
          },
          "openItems": {
            "type": "number",
            "example": 3,
            "description": "Count of still-open interview/receipt items."
          }
        },
        "required": [
          "taxYear",
          "estimate",
          "openItems"
        ]
      },
      "StepDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "question",
              "gate",
              "done"
            ],
            "example": "question"
          },
          "id": {
            "type": "string",
            "example": "ausland",
            "description": "A packages/core StepId (question or gate id). Absent when kind is \"done\"."
          }
        },
        "required": [
          "kind"
        ]
      },
      "InterviewStateDto": {
        "type": "object",
        "properties": {
          "answers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "job": "Angestellt",
              "ausland": "Nein"
            },
            "description": "Every stored answer/gate-acknowledgement so far, keyed by question/gate id (packages/core StepId). Empty object for a tax year with nothing answered yet."
          },
          "nextStep": {
            "description": "@steuereule/core’s nextStep(answers) — never recomputed elsewhere.",
            "allOf": [
              {
                "$ref": "#/components/schemas/StepDto"
              }
            ]
          },
          "openItems": {
            "type": "number",
            "example": 2,
            "description": "Questions still to answer — @steuereule/core’s remainingSteps(answers)."
          }
        },
        "required": [
          "answers",
          "nextStep",
          "openItems"
        ]
      },
      "PostAnswerDto": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string",
            "example": "job",
            "description": "A question or gate id from the graph (packages/core/src/interview.ts) — validated server-side."
          },
          "value": {
            "type": "string",
            "example": "Angestellt",
            "description": "The answer value — validated server-side against this step's own allowed set."
          }
        },
        "required": [
          "questionId",
          "value"
        ]
      },
      "PostAnswerResponseDto": {
        "type": "object",
        "properties": {
          "nextStep": {
            "description": "@steuereule/core’s nextStep(answers) after this write.",
            "allOf": [
              {
                "$ref": "#/components/schemas/StepDto"
              }
            ]
          },
          "openItems": {
            "type": "number",
            "example": 1,
            "description": "Questions still to answer after this write — @steuereule/core’s remainingSteps(answers)."
          }
        },
        "required": [
          "nextStep",
          "openItems"
        ]
      },
      "DeleteAccountRequestDto": {
        "type": "object",
        "properties": {
          "confirm": {
            "type": "boolean",
            "enum": [
              true
            ],
            "example": true,
            "description": "Explicit confirmation — must be exactly `true`. The mandatory pre-delete export offer and Löschschutz warning are a frontend/UX concern; this is the server-side confirmation gate."
          },
          "password": {
            "type": "string",
            "description": "Required only when the caller’s current session is not fresh enough (ADR-0013 §6) — re-verified via better-auth’s own password check, never a second hand-rolled one."
          }
        },
        "required": [
          "confirm"
        ]
      },
      "DeletedSummaryDto": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "boolean",
            "example": true,
            "description": "False only when an active LegalHold on \"profile\" exempted the row — it still exists, retained under legal obligation."
          },
          "account": {
            "type": "boolean",
            "enum": [
              true
            ],
            "example": true,
            "description": "Always true — the account (User, cascading Session/Account) and its Verification rows are always torn down; LegalHold never exempts login/identity itself."
          }
        },
        "required": [
          "profile",
          "account"
        ]
      },
      "DeleteAccountResponseDto": {
        "type": "object",
        "properties": {
          "deleted": {
            "$ref": "#/components/schemas/DeletedSummaryDto"
          },
          "retainedAnonymisedAuditRows": {
            "type": "number",
            "example": 0,
            "description": "Count of TaxDataAccessLog rows anonymised (userId severed to an irreversible tombstone) by this call — retained as the Art. 30 accountability record, no longer person-linkable."
          },
          "retainedUnderLegalHold": {
            "type": "number",
            "example": 0,
            "description": "Count of rows retained untouched — neither erased nor anonymised — because an active LegalHold exempted them."
          }
        },
        "required": [
          "deleted",
          "retainedAnonymisedAuditRows",
          "retainedUnderLegalHold"
        ]
      },
      "ExportAccountDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "anna@example.com"
          },
          "name": {
            "type": "string",
            "example": "Anna Beispiel"
          },
          "emailVerified": {
            "type": "boolean",
            "example": true
          },
          "createdAt": {
            "type": "string",
            "example": "2026-01-15T09:30:00.000Z"
          },
          "authProviders": {
            "example": [
              "credential"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "email",
          "name",
          "emailVerified",
          "createdAt",
          "authProviders"
        ]
      },
      "ExportProfileDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "example": "Anna"
          },
          "lastName": {
            "type": "string",
            "example": "Beispiel"
          },
          "steuerId": {
            "type": "string",
            "example": "02476291358"
          },
          "steuernummer": {
            "type": "string",
            "nullable": true,
            "example": "18181508155"
          },
          "createdAt": {
            "type": "string",
            "example": "2026-01-15T09:30:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "example": "2026-02-01T09:30:00.000Z"
          }
        },
        "required": [
          "firstName",
          "lastName",
          "steuerId",
          "steuernummer",
          "createdAt",
          "updatedAt"
        ]
      },
      "ExportAccessLogEntryDto": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "example": "READ"
          },
          "resource": {
            "type": "string",
            "example": "export"
          },
          "createdAt": {
            "type": "string",
            "example": "2026-02-01T09:30:00.000Z"
          }
        },
        "required": [
          "action",
          "resource",
          "createdAt"
        ]
      },
      "ExportDocumentDto": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "example": "1.0"
          },
          "exportedAt": {
            "type": "string",
            "example": "2026-02-01T09:30:00.000Z"
          },
          "account": {
            "$ref": "#/components/schemas/ExportAccountDto"
          },
          "profile": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ExportProfileDto"
              }
            ]
          },
          "taxData": {
            "example": [],
            "description": "Always empty until a tax-year model exists.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "accessLog": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExportAccessLogEntryDto"
            }
          }
        },
        "required": [
          "schemaVersion",
          "exportedAt",
          "account",
          "profile",
          "taxData",
          "accessLog"
        ]
      },
      "DeviceCodeResponseDto": {
        "type": "object",
        "properties": {
          "userCode": {
            "type": "string",
            "example": "K7QX-9F2M",
            "description": "The short code shown on the desktop and matched on the phone."
          },
          "deviceCode": {
            "type": "string",
            "description": "The RFC 8628 device_code — held by the desktop only, to poll POST /v1/device/token. Not a session credential; carries no authenticated power on its own."
          },
          "verificationUriComplete": {
            "type": "string",
            "description": "The full verification URL to encode as the QR code (includes the user_code as a query param)."
          },
          "expiresIn": {
            "type": "number",
            "description": "Seconds until this code expires (ADR-0024: 2 minutes)."
          },
          "interval": {
            "type": "number",
            "description": "Minimum seconds between POST /v1/device/token polls."
          }
        },
        "required": [
          "userCode",
          "deviceCode",
          "verificationUriComplete",
          "expiresIn",
          "interval"
        ]
      },
      "DevicePendingResponseDto": {
        "type": "object",
        "properties": {
          "userCode": {
            "type": "string",
            "example": "K7QX-9F2M"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "denied"
            ],
            "example": "pending"
          },
          "userAgent": {
            "type": "string",
            "nullable": true,
            "description": "The requesting desktop's raw User-Agent, or null if it was absent."
          },
          "region": {
            "type": "string",
            "nullable": true,
            "description": "Country code from task 0b's geo-IP resolver, or \"unknown\" — never null once task 0/0b's write path has run."
          },
          "requestedAt": {
            "type": "string",
            "nullable": true,

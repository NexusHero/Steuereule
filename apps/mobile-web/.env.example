# Copy to .env for local dev. Never commit real secrets (12-Factor III).

# Origin of the Profile API (apps/api). Expo inlines EXPO_PUBLIC_* at build time.
# Defaults to http://localhost:3000 in App.tsx when unset.
EXPO_PUBLIC_API_BASE_URL="http://localhost:3000"

# Anbieterangaben für Impressum/Datenschutz/AGB (§ 5 DDG, ADR-0050). Ohne Name, Anschrift
# und E-Mail zeigt das Impressum ehrlich "noch nicht hinterlegt" — vor dem öffentlichen
# Go-Live MÜSSEN sie gesetzt sein. Zeilenumbrüche in der Anschrift als \n.
# EXPO_PUBLIC_BETREIBER_NAME="Vorname Nachname"
# EXPO_PUBLIC_BETREIBER_ANSCHRIFT="Musterstraße 1\n12345 Musterstadt"
# EXPO_PUBLIC_BETREIBER_EMAIL="hallo@steuereule.de"
# EXPO_PUBLIC_BETREIBER_VERTRETEN=""
# EXPO_PUBLIC_BETREIBER_USTID=""

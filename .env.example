# Env file of the local production-shaped stack (docker-compose.prod.yml, ADR-0026): the real API and web
# images on your own machine, with NODE_ENV=production. It is NOT the cloud deployment. That runs on Google
# Cloud Run (ADR-0053): its values live in Secret Manager and in the GitHub environments, set up by
# scripts/infra/gcp-setup.sh; infra/README.md lists every step.
# Copy to `.env` at the repo root, then (or simply `scripts/local.sh`, which does both):
#
#   scripts/mail-tls.sh && docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build
#
# Frontend on http://localhost:8080, API on http://localhost:3000.
#
# Mail: docker-compose.prod.yml sends every mail to the local Mailpit inbox (http://localhost:8025) over
# implicit TLS (SMTP_URL=smtps://mailpit:1025). scripts/mail-tls.sh generates the local CA and Mailpit's
# certificate into .local/mail-tls (never committed); the API trusts that CA through SMTP_CA_CERT, a path to
# the CA's PEM file. There is no clear-text SMTP, not even to the local inbox.
#
# API_ORIGIN and WEB_ORIGIN are set once below; docker-compose.prod.yml passes them to both sides (the API's
# CORS_ALLOWED_ORIGINS / WEB_APP_URL / BETTER_AUTH_URL and the web image's build-time EXPO_PUBLIC_API_BASE_URL),
# so the browser's origin and the origin the API trusts cannot drift apart.
API_PORT=3000
WEB_PORT=8080
API_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:8080

# Postgres — synthetic local credentials, matching docker-compose.yml's own base stack
# (never real values, ADR-0003 §4.2).
POSTGRES_USER=steuereule
POSTGRES_PASSWORD=steuereule
POSTGRES_DB=steuereule
# The API's own database login in the production-shaped stack (docker-compose.prod.yml): the migrate
# service creates it without ownership of any table (row-level security, P11). Letters, digits, - and _ only.
POSTGRES_APP_USER=steuereule_api
POSTGRES_APP_PASSWORD=steuereule-api-local-stack-only
# The API's keystore login in the local production-shaped stack (created by the migrate service).
POSTGRES_KEYSTORE_USER=steuereule_keystore_api
POSTGRES_KEYSTORE_PASSWORD=steuereule-keystore-local-stack-only

# Synthetic secrets, published in this repository. The API accepts them only while every origin above is
# localhost and it is not on Cloud Run, and warns at boot; any deployment refuses to start with them
# (apps/api/src/config/production-config.ts). Never point this stack at a public origin with these values.
GUEST_SESSION_SECRET=local-prod-test-guest-session-secret-change-me
PRISMA_FIELD_ENCRYPTION_KEY=k1.aesgcm256.MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Salt of the e-mail lookup hash (ADR-0109). Synthetic, local only. A real one must never change once accounts exist.
PRISMA_FIELD_ENCRYPTION_HASH_SALT=local-only-email-hash-salt-not-a-real-secret
# Synthetic, local-stack-only master key of the receipt keystore (ADR-0059) — never a real secret.
KEYSTORE_MASTER_KEY=local-stack-only-keystore-master-key
BETTER_AUTH_SECRET=local-prod-test-better-auth-secret-change-me-0123456789

# Google OAuth (REQ-008): dev-only placeholders, so the button renders and its plumbing can be tested; not a
# real Google handshake. Accepted only on this localhost stack, refused on a deployment (H2-34).
GOOGLE_CLIENT_ID=dev-only-google-client-id
GOOGLE_CLIENT_SECRET=dev-only-google-client-secret

# Operator details for the Impressum, baked into the web bundle (§ 5 DDG). Empty here: the Impressum then says
# "noch nicht hinterlegt". A deployment takes them from the GitHub environment instead. Line breaks as \n.
# EXPO_PUBLIC_BETREIBER_NAME=
# EXPO_PUBLIC_BETREIBER_ANSCHRIFT=
# EXPO_PUBLIC_BETREIBER_EMAIL=
# EXPO_PUBLIC_BETREIBER_VERTRETEN=
# EXPO_PUBLIC_BETREIBER_USTID=

# Stripe stays off on this stack unless all three are set (test mode only): STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_ID, plus STRIPE_PRICE_ID_SELBSTSTAENDIG. docker-compose.prod.yml does not
# pass them today; a deployment requires them.

# Eulen-Chat (#476)
# With REDIS_URL a running answer can be followed and stopped from any API instance (Redis
# Streams), and the rate limiter counts across instances. Local development uses it by default so
# it runs the same code path as production: `docker compose up -d` starts a Redis on
# localhost:6379. Set it empty (REDIS_URL=) to keep both in the API process instead.
# The prod-shaped stack (docker-compose.prod.yml) sets its own value for the in-network Redis.
REDIS_URL=redis://localhost:6379
# The owl shows its line of thought by default (a reasoning summary from the provider). "off" hides
# it and saves the tokens. AI_ADVISOR_THINKING_LEVEL (low | medium | high | auto, default medium)
# sets how long Gemini thinks before the first word: low 3 to 6 s, medium 6 to 9 s, auto 10 to 13 s.
# AI_ADVISOR_REASONING=off
# AI_ADVISOR_THINKING_LEVEL=medium
# Token budget for the thinking of providers that take one (Anthropic). Default 2048.
# AI_ADVISOR_REASONING_BUDGET=2048

# ── KI-Modell & API-Keys (Steuerberater-Assistent / Eulen-Modus) ───
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIzaSy...
# AI_ADVISOR_PROVIDER=google-genai
# AI_ADVISOR_MODEL=gemini-3.8-flash
# AI_FALLBACK_PROVIDER=anthropic
# AI_FALLBACK_MODEL=claude-sonnet-5-5

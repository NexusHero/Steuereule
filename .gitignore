node_modules/
# pnpm is the sole package manager and `pnpm-lock.yaml` the sole lockfile
# (packageManager: pnpm@10.33.0). npm's lockfile must neither be committed nor
# regenerated by an accidental `npm install` — CI and devs install via pnpm only.
package-lock.json
dist/
# @steuereule/tokens ships its generated theme + CSS so consumers and the drift-guard
# test work without a build step (ADR-050); keep this one dist/ tracked on purpose.
!packages/tokens/dist/
coverage/
.turbo/
*.tsbuildinfo
# Local runtime artifacts (agent worktrees, Expo cache) — never committed.
# But the role team (.claude/agents/) and the skill links (.claude/skills/) ARE tracked.
.claude/*
!.claude/agents/
!.claude/skills/
.expo/
.env
.env.*
!.env.example
# #284's boot test generates two throwaway Prisma clients + src copies here, nested
# under apps/api/ on purpose (module resolution has to climb to the real
# apps/api/node_modules for everything except @prisma/client) — cleaned up in the
# test's own afterAll, this is only a backstop for a run that was killed mid-suite.
apps/api/.generated-test-clients/
# Same #284 fixture's throwaway schema files (env-snapshot-client-fixtures.ts's
# `generateClientAt`) — deliberately written NEXT TO the real schema.prisma, not under
# .generated-test-clients/ above, because the relative distance from schema to
# "project root .env" is what Prisma's env search actually uses. Removed in the same
# function's own `finally` and by its exit-cleanup backstop; this is only a second
# backstop for the one gap neither covers — a SIGKILL landing mid `prisma generate`,
# noticed via `git status` rather than silently committed (coordinator flagged this
# tree was reachable by `git add -A` with no ignore rule, 2026-08-11).
apps/api/prisma/.generated-test-schema-*.prisma
# macOS Finder/Spotlight artefacts.
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
# Editor / IDE artefacts.
.idea/
.vscode/
*.swp
*~

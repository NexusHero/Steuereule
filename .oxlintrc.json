{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "**/.expo/**",
    "**/generated/**",
    "spikes/**",
    "finanzo-funke-design-system/**",
    "Documentation/**"
  ],
  "rules": {
    "typescript/ban-ts-comment": ["error", { "ts-expect-error": "allow-with-description" }],
    "typescript/no-extraneous-class": ["error", { "allowWithDecorator": true }],
    "eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],

    "unicorn/no-array-sort": "off",
    "unicorn/no-invalid-fetch-options": "off",
    "unicorn/consistent-function-scoping": "off",
    "eslint/no-underscore-dangle": "off",

    // One construction site for the auth client (apps/mobile-web/src/auth/auth-client.ts, #257).
    "eslint/no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "better-auth/react",
            "importNames": ["createAuthClient"],
            "message": "Construct the auth client only in apps/mobile-web/src/auth/auth-client.ts; import it from there."
          },
          {
            "name": "better-auth/client",
            "importNames": ["createAuthClient"],
            "message": "Construct the auth client only in apps/mobile-web/src/auth/auth-client.ts; import it from there."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["apps/mobile-web/src/auth/auth-client.ts"],
      "rules": { "eslint/no-restricted-imports": "off" }
    }
  ]
}

        "apps/api/src/**/*.module.ts",
        "apps/api/src/config/assert-database-migrated.ts",
        "apps/api/src/config/assert-database-reachable.ts",
        "apps/api/src/config/database-url.ts",
        "apps/api/src/auth/better-auth.ts",
        "apps/api/src/health/pooled-database-reachability-check.ts",
        "apps/api/src/receipt/storage/postgres-bytea-storage.adapter.ts"
      ],

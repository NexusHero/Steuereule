# One file per environment, for example staging.tfvars and production.tfvars.
project_id          = "steuereule-staging"
billing_account_id  = "000000-000000-000000"
environment         = "staging"
github_environments = ["staging"]
alert_email         = "ops@example.org"
api_hostname        = "api.staging.example.org"
monthly_budget_eur  = 60
# Staging stack only: let the production deployer pull the API image that staging ran (ADR-0113).
# The service account exists after the production stack is applied; its name is steuereule-deployer.
# image_readers     = ["serviceAccount:steuereule-deployer@steuereule-production.iam.gserviceaccount.com"]

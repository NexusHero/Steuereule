{
  "name": "steuereule",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "coverage": "pnpm --filter @steuereule/core coverage",
    "lint": "oxlint --deny-warnings",
    "gate": "pnpm -r typecheck && pnpm -r test",
    "register-check": "node scripts/checks/register-check.mjs",
    "adr-check": "node scripts/checks/adr-check.mjs",
    "docs:diagrams": "./scripts/docs/render-diagrams.sh",
    "check:better-auth": "node scripts/checks/better-auth-version-check.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.12",
    "oxlint": "^1.95.0",
    "turbo": "^2.11.13",
    "typescript": "^7.0.0",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "react-native": "0.88.1",
      "react-i18next": "15.7.4",
      "i18next": "26.3.4",
      "@huggingface/transformers>onnxruntime-node": "-",
      "@huggingface/transformers>sharp": "-",
      "@prisma/config>deepmerge-ts": "^8.0.0",
      "glob@>=9.0.0 <14.0.2": "^14.0.2",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
      "orval>js-yaml": "4.3.2",
      "effect": "3.22.5",
      "@fastify/static": "^10.1.12",
      "nodemailer": "^10.6.1",
      "undici": "^6.29.1",
      "find-my-way": ">=9.10.2",
      "fast-uri@>=3.0.0 <4.0.0": "^3.1.7",
      "fast-uri@>=4.0.0": "^4.1.4",
      "prisma-field-encryption>zod": "^4.6.7",
      "source-map-js": "^1.2.2",
      "fastify": "^5.12.8",
      "nanoid@>=3.0.0 <4.0.0": "^3.3.18",
      "brace-expansion@>=5.0.0 <5.1.0": "^5.1.0"
    },
    "onlyBuiltDependencies": [
      "@bundled-es-modules/glob",
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "@swc/core",
      "esbuild",
      "prisma",
      "style-dictionary"
    ]
  }
}

{
  "name": "steuereule",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "coverage": "pnpm --filter @steuereule/core coverage",
    "lint": "oxlint --deny-warnings",
    "gate": "pnpm -r typecheck && pnpm -r test",
    "register-check": "node scripts/checks/register-check.mjs",
    "adr-check": "node scripts/checks/adr-check.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "oxlint": "^1.76.0",
    "turbo": "^2.3.3",
    "typescript": "^7.0.0",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "react": "19.0.0",
      "react-dom": "19.0.0",
      "react-native": "0.79.5",
      "react-i18next": "15.7.4",
      "i18next": "24.2.3"
    },
    "onlyBuiltDependencies": [
      "@bundled-es-modules/glob",
      "@prisma/client",
      "@prisma/engines",
      "@scarf/scarf",
      "@swc/core",
      "esbuild",
      "prisma",
      "style-dictionary"
    ]
  }
}

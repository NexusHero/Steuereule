{
  "name": "steuereule",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "coverage": "pnpm --filter @steuereule/core coverage",
    "lint": "eslint .",
    "gate": "pnpm -r typecheck && pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "turbo": "^2.3.3",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}

rectangle "AdvisorDocumentStaging" as Staging
rectangle "ADVISOR_REPOSITORY" as Repo
rectangle "TRANSACTION_RUNNER" as Tx
rectangle "ADVISOR_TOPIC_GUARD\nAdvisorTopicGuard" as Guard
rectangle "createChatModelFromConfig\nAnthropic · OpenAI · Google · fake" as Factory

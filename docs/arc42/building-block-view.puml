@startuml building-block-view
' Rendered with PlantUML's built-in Smetana layout (pure Java) so the SVG export
' needs no external Graphviz/dot install — reproducible in CI and on any machine.
!pragma layout smetana
' arc42 §5 — Building Block View (Level 1 whitebox) of the SteuerEule system.
' Source of record for the diagram; export to building-block-view.svg (see README).
' Highlighted (green) = building blocks added since this view's previous revision
' (Slice 2's auth stack + REQ-011's DSGVO export/deletion): REQ-014's QR device
' authorization (ADR-0024) and the app's first real router (ADR-0023).
' Dashed border = landing in review on steuereule#239, not yet on main — the marker
' comes off when the slice merges, exactly as DatenschutzScreen's did at #153.
' Keep this in step with the code — a stale arc42 is treated as a failing test.
skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam shadowing false
skinparam rectangleBorderColor #6b7280
skinparam packageBorderColor #6b7280

title SteuerEule — Building Block View (Level 1) · arc42 §5\ngreen = added since the Slice-2/REQ-011 revision (REQ-014 QR device authorization · first router)\ndashed = in review on #239, not yet on main

actor "User\n(guest session or\nverified account)" as user

package "apps/mobile-web  ·  Expo / React-Native-Web" as fe {
  component "App.tsx — composition root\n@react-navigation/native + native-stack\nroute table + linking config\n**the one @react-navigation import site**" as router #palegreen;line.dashed
  component "SplashScreen" as splash
  component "LoginScreen · RegistrierungScreen\nemail/password · guest · Google\n+ open QR column (QrMark)" as login
  component "GeraetefreigabeScreen\nmatch verification: is this code\non your screen? + warning copy" as approval #palegreen;line.dashed
  component "OnboardingScreen" as onb
  component "CockpitScreen\n(hero estimate card,\nhonest states)" as cockpitScreen
  component "ProfilScreen\n(view/edit stored profile)\n+ device list · per-entry revoke" as profilScreen
  component "DatenschutzScreen\nDSGVO export + deletion" as datenschutzScreen
  component "AuthClientProvider\nthe one better-auth client\n(session · sign-in/up/out)" as authClient
  component "exportDownload.ts\nthe one documented egress\noutside the generated client" as exportDl
}

package "Shared packages (monorepo)" as pkgs {
  component "@steuereule/core\ndeterministic domain —\nvalidators · cockpitRange()" as core
  component "@steuereule/api-client\norval-generated typed client\n+ TanStack Query hooks\nprofile · cockpit · auth · account" as apiclient
  component "@steuereule/ui\nFunke design system" as ui
  component "@steuereule/tokens\ndesign tokens" as tokens
}

package "apps/api  ·  NestJS on Fastify" as api {
  component "better-auth\nFastify catch-all on /api/auth/*\n(mounted outside Nest)\ndevice-authorization plugin:\nHTTP routes disabledPaths-off" as betterauth
  component "UserContextGuard\nidentity seam (ADR-0007/0012):\nverified session OR signed guest cookie" as guard
  component "AuthModule\ncapabilities · guest→account upgrade\nFreshAuthChecker · breach-check\nEmailSender seam" as authMod
  component "DeviceModule  (ADR-0024)\n/v1/device/{code,pending,approve,token}\nour surface in front of the plugin\nsession-cookie.ts · pending rate limit" as deviceMod #palegreen;line.dashed
  component "RegionResolver  (ADR-0024)\ncountry-level geo-IP, self-hosted\nnever guesses — resolves to 'unknown'\ntwo consumers: approval + device list" as region #palegreen;line.dashed
  component "ProfileModule\nGET/PUT /v1/profile" as profile
  component "CockpitModule\nGET /v1/steuerjahre/{jahr}/cockpit" as cockpitMod
  component "AccountModule\nGET /v1/account/export (JSON · PDF)\nDELETE /v1/account (teardown txn)\nPdfRenderer seam" as accountMod
  component "AuditModule\nTaxDataAccessLog (append-only)" as audit
  component "PrismaModule\nfield-encrypted Prisma client" as prisma
  component "Cross-cutting\nCORS allowlist (ADR-0011) ·\nhelmet/CSP ·\nDB-backed rate limits — NOT effective:\nIP-keyed via untrusted X-Forwarded-For,\nbypassable (#241), closes with #246" as crosscut #palegreen
}

database "Postgres (EU)\nexpand-only migrations (ADR-047)" as db {
  component "Profile" as tProfile
  component "TaxDataAccessLog" as tAudit
  component "TaxYear" as tTaxYear
  component "User · Session ·\nAccount · Verification\n(better-auth)" as tAuth
  component "LegalHold · RateLimit" as tHold
  component "DeviceCode\n9 plugin fields + our 4\nrequest-context columns" as tDevice #palegreen;line.dashed
}

